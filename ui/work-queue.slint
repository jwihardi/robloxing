import { ListView } from "std-widgets.slint";
import { Theme, Action } from "common.slint";

export struct WorkRow { id: string, title: string, status: string, owner: string, detail: string, current: bool }

export component WorkQueuePage inherits Rectangle {
    in property <[WorkRow]> items;
    in property <bool> busy;
    in property <bool> more;
    in property <int> offset;
    in property <string> problem;
    callback refresh(int);
    callback open(string);
    callback back();
    background: Theme.canvas;

    VerticalLayout {
        width: min(810px, root.width - 48px); x: (root.width - self.width) / 2;
        y: 24px; height: root.height - 48px; spacing: 14px;
        HorizontalLayout { spacing: 8px; height: 38px;
            Text { text: "Project work queue"; color: Theme.text; font-size: 23px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
            Action { label: "Back to chats"; width: 106px; activate => {root.back();} }
        }
        if root.problem != "" || root.items.length == 0: Text {
            text: root.problem != "" ? root.problem : (root.offset > 0 ? "No more open work." : "No open work.");
            color: Theme.muted; font-size: 15px; wrap: word-wrap;
        }
        list := ListView { vertical-stretch: 1;
            for row in root.items: VerticalLayout {
                width: list.visible-width; padding-top: 9px; spacing: 5px;
                HorizontalLayout { spacing: 12px;
                    VerticalLayout { spacing: 4px; horizontal-stretch: 1;
                        HorizontalLayout { height: 21px; spacing: 12px;
                            Text { text: row.status; color: row.status == "Needs attention" || row.status == "Paused" ? Theme.halfway : Theme.accent; font-size: 13px; font-weight: 600; }
                            Text { text: row.owner; color: Theme.muted; font-size: 12px; font-family: Theme.mono; horizontal-stretch: 1; overflow: elide; }
                        }
                        Text { text: row.title; color: Theme.text; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                        Text { text: row.detail; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                    }
                    Action { label: "Open chat"; accessible-label: "Open chat " + row.title; width: 90px; enabled: !root.busy || row.current; activate => {root.open(row.id);} }
                }
                Rectangle { height: 7px; }
                Rectangle { height: 1px; background: Theme.line; }
            }
        }
        HorizontalLayout { height: 36px; spacing: 6px;
            Action { label: "Refresh"; width: 78px; activate => {root.refresh(root.offset);} }
            Rectangle { horizontal-stretch: 1; }
            if root.offset > 0: Action { label: "Previous"; width: 80px; activate => {root.refresh(max(0,root.offset - 40));} }
            if root.more: Action { label: "Next"; width: 70px; activate => {root.refresh(root.offset + 40);} }
        }
    }
}
