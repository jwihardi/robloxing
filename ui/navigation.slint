import { Action, RowAction, Theme } from "common.slint";
import { ListView, LineEdit } from "std-widgets.slint";
import { AssetPacks } from "asset-packs.slint";
import { Studio } from "studio.slint";

export component ChatHistoryRow inherits Rectangle {
    in property <string> title;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> restore-delete-focus;
    callback open();
    callback remove();
    height: 36px;
    background: root.selected ? Theme.selected : entry.hovered || trash.hovered ? Theme.surface : transparent;
    border-radius: 9px;
    changed restore-delete-focus => { if root.restore-delete-focus { trash.focus(); } }
    entry := RowAction {
        x: 0px; width: parent.width - trash.width; height: parent.height; label: root.title; enabled: root.enabled;
        activate => { root.open(); }
    }
    trash := Action {
        x: entry.width; y: 2px; width: 32px; height: parent.height - 4px;
        icon-only: true; glyph: "\u{e74d}"; label: "Delete chat “" + root.title + "”"; enabled: root.enabled;
        opacity: root.selected || entry.hovered || entry.focused || self.hovered || self.focused ? 1 : 0;
        glyph-color: self.hovered || self.focused ? Theme.scarce : Theme.muted;
        activate => { root.remove(); }
    }
}

export component DeleteChatDialog inherits FocusScope {
    in property <string> chat-title;
    callback cancel();
    callback confirm();
    focus-on-click: false;
    init => { keep.focus(); }
    capture-key-pressed(e) => {
        if e.text == Key.Escape { root.cancel(); return accept; }
        if e.text == Key.Tab || e.text == Key.Backtab {
            if keep.focused { remove.focus(); } else { keep.focus(); }
            return accept;
        }
        return reject;
    }
    Rectangle { background: #0009; }
    TouchArea {}
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(394px, parent.width - 32px); height: body.preferred-height;
        border-radius: 18px; background: Theme.popup; border-color: Theme.line; border-width: 1px;
        accessible-role: groupbox; accessible-label: "Delete chat?";
        body := VerticalLayout {
            padding: 22px; spacing: 10px;
            Text { text: "Delete chat?"; color: Theme.text; font-size: 20px; font-weight: 600; }
            Text { text: "“" + root.chat-title + "”"; color: Theme.text; font-size: 14px;
                wrap: word-wrap; overflow: elide; max-height: 56px; }
            Text { text: "This permanently removes the conversation and its unaccepted changes.";
                color: Theme.muted; font-size: 14px; wrap: word-wrap; }
            HorizontalLayout {
                padding-top: 8px; spacing: 8px; alignment: end;
                keep := Action { label: "Cancel"; width: 76px; outlined: true; activate => { root.cancel(); } }
                remove := Action { label: "Delete chat"; width: 100px; primary: true;
                    background: self.hovered ? Theme.scarce.brighter(0.12) : Theme.scarce;
                    activate => { root.confirm(); } }
            }
        }
    }
}

export component RailAction inherits Action {
    in property <string> caption;
    icon-only: true;
    height: 56px; border-radius: 12px;
    if root.selected: Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: 3px; height: 19px; border-radius: 1.5px; background: Theme.accent;
    }
    VerticalLayout { alignment: center; spacing: 4px;
        Text { text: root.symbol; font-family: "Segoe MDL2 Assets"; font-size: 19px;
            color: root.selected ? Theme.accent : Theme.muted; horizontal-alignment: center; accessible-role: none; }
        Text { text: root.caption; font-size: 11px; font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.text : Theme.muted; horizontal-alignment: center; accessible-role: none; }
    }
    in property <string> symbol;
}

export component WorkshopMark inherits Rectangle {
    width: 34px; height: 34px; background: Theme.brand-fill; border-radius: 11px;
    border-width: 1px; border-color: Theme.accent.mix(Theme.brand-fill, 0.22);
    Path { x: parent.width * 0.22; y: parent.height * 0.30; width: parent.width * 0.28; height: parent.height * 0.37;
        viewbox-width: 12; viewbox-height: 18; stroke: Theme.accent; stroke-width: 2px;
        commands: "M 1 1 L 10 9 L 1 17"; }
    Rectangle { x: parent.width * 0.51; y: parent.height * 0.64; width: parent.width * 0.23;
        height: 2px; border-radius: 1px; background: Theme.accent; }
}

export component StudioNavigation inherits VerticalLayout {
    spacing: 5px;
    Text { text: "Project tools"; font-size: 19px; font-weight: 600; color: Theme.text; height: 40px; vertical-alignment: center; }
    for tool[i] in ["Assets", "Packs", "Ghidra"]: RowAction {
        label: ["Saved assets", "Asset packs", "Decompilation"][i]; glyph: ["\u{e91b}", "\u{e8b7}", "\u{e943}"][i];
        selected: Studio.area == tool; activate => {
            Studio.editing-run = false; Studio.area = tool; Studio.query = ""; Studio.command("refresh"); root.picked();
        }
    }
    Rectangle { height: 15px; }
    Text { text: Studio.area == "Ghidra" ? "Report history" : Studio.area == "Packs" ? "Project packs" : "Project library"; color: Theme.symbol; font-family: Theme.mono; font-size: 13px; }
    if Studio.area == "Packs": pack-list := ListView { vertical-stretch: 1;
        for pack in AssetPacks.packs: RowAction { width: pack-list.visible-width; label: pack.name; selected: AssetPacks.pack.key == pack.key;
            activate => { AssetPacks.select-pack(pack.key); root.picked(); } }
    }
    if Studio.area != "Packs": LineEdit { height: 34px; accessible-label: Studio.area == "Ghidra" ? "Search reports" : "Search assets";
        placeholder-text: Studio.area == "Ghidra" ? "Find binary or function" : "Search assets"; text <=> Studio.query; }
    if Studio.area != "Packs" && Studio.jobs.length == 0: Text { text: Studio.query != "" ? (Studio.area == "Ghidra" ? "No matching reports." : "No matching assets.") : (Studio.area == "Ghidra" ? "No runs yet" : "No assets yet"); color: Theme.muted; font-size: 13px; height: 36px; vertical-alignment: center; }
    if Studio.area != "Packs": history := ListView { vertical-stretch: 1;
        for job in Studio.jobs: RowAction {
            width: history.visible-width; height: 52px; label: job.title; detail: (Studio.area == "Ghidra" ? "#" + job.id + " · " : "") + (Studio.area == "Assets" ? (job.area == "Models" ? "3D model · " : job.area == "Sounds" ? "Sound effect · " : "Image · ") : "") + (job.state == "Ready" ? job.date : job.state);
            selected: Studio.selected.id == job.id; accessible-description: job.state + " " + job.date;
            activate => {Studio.editing-run = false; Studio.select(job.id); root.picked();}
        }
    }
    callback picked();
}
