import { Action, RowAction, Theme } from "common.slint";
import { ListView, LineEdit } from "std-widgets.slint";
import { Studio } from "studio.slint";

export component RailAction inherits Action {
    in property <string> caption;
    icon-only: true;
    height: 56px; border-radius: 12px;
    if root.selected: Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: 3px; height: 19px; border-radius: 1.5px; background: Theme.accent;
    }
    VerticalLayout { alignment: center; spacing: 4px;
        Text { text: root.symbol; font-family: "Segoe MDL2 Assets"; font-size: 19px;
            color: root.selected ? Theme.accent : Theme.muted; horizontal-alignment: center; accessible-role: none; }
        Text { text: root.caption; font-size: 11px; font-weight: root.selected ? 600 : 400;
            color: root.selected ? Theme.text : Theme.muted; horizontal-alignment: center; accessible-role: none; }
    }
    in property <string> symbol;
}

export component WorkshopMark inherits Rectangle {
    width: 34px; height: 34px; background: Theme.brand-fill; border-radius: 11px;
    border-width: 1px; border-color: Theme.accent.mix(Theme.brand-fill, 0.22);
    Path { x: parent.width * 0.22; y: parent.height * 0.30; width: parent.width * 0.28; height: parent.height * 0.37;
        viewbox-width: 12; viewbox-height: 18; stroke: Theme.accent; stroke-width: 2px;
        commands: "M 1 1 L 10 9 L 1 17"; }
    Rectangle { x: parent.width * 0.51; y: parent.height * 0.64; width: parent.width * 0.23;
        height: 2px; border-radius: 1px; background: Theme.accent; }
}

export component StudioNavigation inherits VerticalLayout {
    spacing: 5px;
    Text { text: "Project tools"; font-size: 19px; font-weight: 600; color: Theme.text; height: 40px; vertical-alignment: center; }
    for tool[i] in ["Assets", "Ghidra"]: RowAction {
        label: i == 0 ? "Saved assets" : "Decompilation"; glyph: ["\u{e91b}", "\u{e943}"][i];
        selected: Studio.area == tool; activate => {
            Studio.editing-run = false; Studio.area = tool; Studio.query = ""; Studio.command("refresh"); root.picked();
        }
    }
    Rectangle { height: 15px; }
    Text { text: Studio.area == "Ghidra" ? "Report history" : "Project library"; color: Theme.symbol; font-family: Theme.mono; font-size: 13px; }
    LineEdit { height: 34px; accessible-label: Studio.area == "Ghidra" ? "Search reports" : "Search assets";
        placeholder-text: Studio.area == "Ghidra" ? "Find binary or function" : "Search assets"; text <=> Studio.query; }
    if Studio.jobs.length == 0: Text { text: Studio.query != "" ? (Studio.area == "Ghidra" ? "No matching reports." : "No matching assets.") : (Studio.area == "Ghidra" ? "No runs yet" : "No assets yet"); color: Theme.muted; font-size: 13px; height: 36px; vertical-alignment: center; }
    history := ListView { vertical-stretch: 1;
        for job in Studio.jobs: RowAction {
            width: history.visible-width; height: 52px; label: job.title; detail: (Studio.area == "Ghidra" ? "#" + job.id + " · " : "") + (Studio.area == "Assets" ? (job.area == "Models" ? "3D model · " : "Image · ") : "") + (job.state == "Ready" ? job.date : job.state);
            selected: Studio.selected.id == job.id; accessible-description: job.state + " " + job.date;
            activate => {Studio.editing-run = false; Studio.select(job.id); root.picked();}
        }
    }
    callback picked();
}
