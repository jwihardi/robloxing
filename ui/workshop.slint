import { ListView, ScrollView, Palette, CheckBox, LineEdit } from "std-widgets.slint";

export struct WorkerRow { id: int, title: string, state: string, detail: string, stats: string, running: bool }
export struct ChatTurn { from-user: bool, delivery-notice: bool, body: string, dispatch-id: int, workers: [WorkerRow], shot: string }
export struct AlbumItem { key: string, project: string, date: string }
export struct PolicyModel { value: string, label: string, selected: bool }
export struct SettingRow { id: string, label: string, detail: string, action: string, button: string }
export struct PickerOption { value: string, label: string }
export struct MeterData { label: string, remaining: float, detail: string }
export struct PickerData {
    models: [PickerOption], efforts: [PickerOption], model-index: int, effort-index: int,
    current-model: string, current-effort: string
}

enum OpenPanel { closed, add, effort, models, policy, usage, options, outputs }

global Theme {
    out property <color> popup: #2c2c2c;
    out property <color> track: #454545;
    out property <color> canvas: #202020;
    out property <color> sidebar: #181818;
    out property <color> surface: #303030;
    out property <color> selected: #3b3b3b;
    out property <color> line: #474747;
    out property <color> text: #f5f5f5;
    out property <color> muted: #b5b5b5;
    out property <color> accent: #eeeeee;
    out property <color> accent-hover: #ffffff;
    out property <color> disabled: #444444;
    out property <color> ample: #8dcea6;
    out property <color> halfway: #e4bc73;
    out property <color> scarce: #ed827e;
}

component Flyout inherits FocusScope {
    callback escape();
    focus-on-click: false;
    capture-key-pressed(e) => {
        if e.text == Key.Escape {root.escape(); return accept;}
        return reject;
    }
    TouchArea {} // Keep clicks on empty panel space inside the panel.
    @children
}

component RemainingValue inherits Text {
    in property <float> fraction;
    text: fraction < 0 ? "—" : round(fraction * 100) + "%";
    color: fraction < 0 ? Theme.muted : fraction < 0.5
        ? Theme.halfway.mix(Theme.scarce, fraction * 2)
        : Theme.ample.mix(Theme.halfway, (fraction - 0.5) * 2);
    vertical-alignment: center; font-size: 13px;
}

component InlineReading inherits HorizontalLayout {
    in property <MeterData> reading;
    spacing: 4px;
    Text { text: root.reading.label; color: Theme.muted; vertical-alignment: center; font-size: 13px; }
    RemainingValue { fraction: root.reading.remaining; }
}

component Action inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <string> glyph;
    in property <bool> icon-only: false;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback activate();
    height: 36px;
    border-radius: primary ? 17px : 13px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: primary ? (enabled ? (area.pressed ? Theme.muted : area.has-hover ? Theme.accent-hover : Theme.accent) : Theme.disabled)
        : enabled && area.pressed ? Theme.track : selected ? Theme.selected : enabled && area.has-hover ? Theme.surface : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.activate(); } }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: root.icon-only ? 0px : 10px; padding-right: root.icon-only ? 0px : 10px;
        spacing: 10px; alignment: root.icon-only ? center : start;
        if root.glyph != "": Text { text: root.glyph; vertical-alignment: center; font-size: 15px;
            font-family: "Segoe MDL2 Assets"; color: root.primary && root.enabled ? Theme.canvas : Theme.muted; accessible-role: none; }
        if !root.icon-only && root.detail == "": Text { text: root.label; vertical-alignment: center; font-size: 14px;
            color: root.enabled ? Theme.text : Theme.muted; overflow: elide; accessible-role: none; }
        if root.detail != "": VerticalLayout { alignment: center; spacing: 2px;
            Text { text: root.label; color: Theme.text; font-size: 14px; accessible-role: none; }
            Text { text: root.detail; color: Theme.muted; font-size: 12px; accessible-role: none; }
        }
    }
    area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.activate(); } }
    focus := FocusScope { focus-on-click: false; width: 0px; enabled: root.enabled;
        key-pressed(e) => { if e.text == Key.Return || e.text == Key.Space { root.activate(); return accept; } return reject; }
    }
}

component UsageSummary inherits Action {
    in property <MeterData> context;
    in property <[MeterData]> windows;
    label: "Context and usage"; icon-only: true;
    width: line.preferred-width; height: 30px;
    callback open();
    activate => { root.open(); }
    line := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 10px; alignment: center;
        InlineReading { reading: root.context; }
        for window in root.windows: InlineReading { reading: window; }
    }

}

component WorkerGroup inherits VerticalLayout {
    in property <string> label;
    in property <[WorkerRow]> workers;
    in property <bool> open;
    in property <int> expanded-worker;
    callback toggle();
    callback choose-worker(int);
    callback stop-worker(int);
    alignment: start; spacing: 0px;
    Action {
        label: root.label;
        glyph: root.open ? "\u{e70d}" : "\u{e76c}";
        accessible-expanded: root.open;
        activate => { root.toggle(); }
    }
    if root.open: VerticalLayout {
        padding-left: 17px; spacing: 0px;
        for agent[index] in root.workers: HorizontalLayout {
            spacing: 6px;
            Rectangle { width: 10px;
                Rectangle { width: 1px; height: index == root.workers.length - 1 ? 18px : parent.height; background: Theme.line; }
                Rectangle { y: 18px; width: parent.width; height: 1px; background: Theme.line; }
            }
            VerticalLayout { spacing: 0px;
                HorizontalLayout {
                    Action { label: agent.title; horizontal-stretch: 1; selected: root.expanded-worker == agent.id;
                        activate => {root.choose-worker(agent.id);}
                    }
                    Text { text: agent.state; color: agent.running ? Theme.accent : Theme.muted; vertical-alignment: center; font-size: 13px; }
                }
                if root.expanded-worker == agent.id: VerticalLayout { padding-left: 10px; padding-bottom: 9px; spacing: 5px;
                    Text { text: agent.detail; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                    Text { text: agent.stats; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                    if agent.running: Action { label: "Stop worker"; activate => {root.stop-worker(agent.id);} }
                }
            }
        }
    }
}

component EffortTrack inherits Rectangle {
    in property <bool> enabled: true;
    in property <[PickerOption]> levels;
    in property <int> selected;
    in property <string> name;
    private property <int> dragging: -1;
    out property <int> shown: dragging >= 0 ? dragging : selected;
    private property <int> last: max(0, levels.length - 1);
    private property <length> inset: 17px;
    private property <length> span: self.width - 2 * inset;
    callback commit(int);
    callback dismiss();
    function hit(x: length) -> int { return round(clamp((x - inset) / max(1px, span), 0, 1) * last); }
    function pick(i: int) {
        if root.enabled && levels.length > 0 { root.commit(clamp(i, 0, last)); }
    }
    accessible-role: slider; accessible-label: name;
    accessible-value: max(0, shown); accessible-value-minimum: 0; accessible-value-maximum: last;
    accessible-value-step: 1; accessible-orientation: horizontal; accessible-enabled: root.enabled && levels.length > 1;
    accessible-description: shown >= 0 && shown < levels.length ? levels[shown].label : "Default";
    accessible-action-set-value(v) => { if v.is-float() { root.pick(round(v.to-float())); } }
    accessible-action-increment => { root.pick(root.shown + 1); }
    accessible-action-decrement => { root.pick(root.shown - 1); }
    forward-focus: keys;
    border-radius: self.height / 2; border-width: keys.has-focus ? 1px : 0px; border-color: Theme.text;
    rail := Rectangle {
        x: 2px; width: parent.width - 4px; height: 30px; y: (parent.height - self.height)/2;
        border-radius: 15px; background: Theme.track;
    }
    private property <length> thumb-x: inset + span * max(0, shown) / max(1,last);
    if shown >= 0: Rectangle {
        x: rail.x; y: rail.y; height: rail.height; width: thumb-x - self.x + 12px;
        border-radius: 15px; background: Theme.text;
    }
    for level[i] in levels: Rectangle {
        x: root.inset + root.span * i / max(1,root.last) - 2.5px;
        y: (parent.height - self.height)/2; width: 5px; height: 5px; border-radius: 3px;
        background: i <= root.shown ? transparent : #858585;
    }
    if levels.length > 0 && shown >= 0: Rectangle {
        x: thumb-x - 17px; y: (parent.height - self.height)/2; width: 34px; height: 34px;
        border-radius: 17px; background: white; border-width: 1px; border-color: #dedede;
    }
    touch := TouchArea {
        enabled: root.enabled && root.levels.length > 1; mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                keys.focus(); root.dragging = root.hit(self.mouse-x);
            } else if e.kind == PointerEventKind.up && root.dragging >= 0 {
                root.pick(root.hit(self.mouse-x)); root.dragging = -1;
            } else if e.kind == PointerEventKind.cancel { root.dragging = -1; }
        }
        moved => { if self.pressed && root.dragging >= 0 { root.dragging = root.hit(self.mouse-x); } }
    }
    keys := FocusScope {
        focus-on-click: false; enabled: root.enabled && root.levels.length > 1;
        key-pressed(e) => {
            if e.text == Key.Escape { root.dismiss(); return accept; }
            if e.text == Key.RightArrow || e.text == Key.UpArrow { root.pick(root.shown+1); return accept; }
            if e.text == Key.LeftArrow || e.text == Key.DownArrow { root.pick(root.shown - 1); return accept; }
            if e.text == Key.Home { root.pick(0); return accept; }
            if e.text == Key.End { root.pick(root.last); return accept; }
            return reject;
        }
    }
}

component InferencePicker inherits Rectangle {
    in property <PickerData> choices;
    in property <string> role-name;
    in property <bool> enabled;
    callback open();
    preferred-width: pill-text.preferred-width + 38px;
    height: 34px; border-radius: 17px;
    background: enabled && hit.pressed ? Theme.line : hit.has-hover && enabled ? Theme.track : Theme.selected;
    border-width: trigger.has-focus ? 1px : 0px; border-color: Theme.text;
    accessible-role: button; accessible-label: role-name + " model and effort";
    accessible-description: choices.current-model + ", " + choices.current-effort;
    accessible-enabled: enabled; accessible-action-default => { if root.enabled { root.open(); } }
    forward-focus: trigger;
    pill-text := Text {
        x: 12px; width: parent.width - 36px; vertical-alignment: center;
        text: root.choices.current-model + "  ·  " + root.choices.current-effort;
        color: root.enabled ? Theme.text : Theme.muted; font-size: 13px; overflow: elide; accessible-role: none;
    }
    Text { x: parent.width - 22px; width: 14px; vertical-alignment: center; text: "\u{e70d}"; font-family: "Segoe MDL2 Assets"; color: Theme.muted; font-size: 10px; accessible-role: none; }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { trigger.focus(); root.open(); } }
    trigger := FocusScope { focus-on-click: false; enabled: root.enabled; key-pressed(e) => {
        if e.text == Key.Return || e.text == Key.Space { root.open(); return accept; } return reject;
    } }
}

component Composer inherits Rectangle {
    in property <[PickerOption]> attachments;
    callback remove-attachment(int);
    callback open-add(length,length,length,length);
    in property <PickerData> choices;
    in property <bool> picking;
    callback open-picker(length,length,length,length);
    in-out property <string> value;
    in property <bool> enabled: true;
    in property <bool> running;
    in property <bool> can-send;
    callback send();
    callback stop();
    callback subagents();
    in property <bool> policy-enabled;
    out property <length> subagent-x: subagent-button.absolute-position.x;
    out property <length> subagent-y: subagent-button.absolute-position.y;
    out property <length> subagent-width: subagent-button.width;
    out property <length> subagent-height: subagent-button.height;
    in property <bool> custom-subagents;
    forward-focus: input;
    private property <length> attachment-height: min(2,root.attachments.length) * 32px;
    height: 74px + min(108px, max(38px, input.preferred-height)) + root.attachment-height; border-radius: 27px; background: Theme.surface;
    border-width: 1px; border-color: input.has-focus ? #727272 : Theme.line;
    public function focus-input() { input.focus(); }
    public function focus-add() { plus.focus(); }
    public function paste-text() { input.focus(); input.paste(); }
    public function focus-picker() { inference.focus(); }
    public function focus-subagents() { subagent-button.focus(); }
    if root.attachments.length > 0: attached := ListView {
        x: 14px; y: 9px; width: parent.width - 28px; height: root.attachment-height;
        for file[i] in root.attachments: HorizontalLayout {
            width: attached.visible-width - 4px; height: 32px; spacing: 8px;
            Text { width: 20px; text: "\u{e723}"; font-family: "Segoe MDL2 Assets"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
            Text { text: file.label; accessible-description: file.value; horizontal-stretch: 1; min-width: 0px; vertical-alignment: center; overflow: elide; font-size: 13px; color: Theme.text; }
            Action { label: "Remove " + file.label; accessible-description: file.value; icon-only: true; glyph: "\u{e711}"; width: 32px; height: 32px; enabled: root.enabled;
                activate => {root.remove-attachment(i);} }
        }
    }
    scroller := ScrollView {
        x: 18px; y: 15px + root.attachment-height; width: parent.width - 36px; height: parent.height - 74px - root.attachment-height;
        content-width: self.visible-width; content-height: max(self.visible-height, input.preferred-height);
        input := TextInput {
            width: scroller.visible-width; height: max(scroller.visible-height, self.preferred-height);
            text <=> root.value; color: Theme.text; font-size: 16px;
            selection-background-color: Theme.selected; single-line: false; wrap: word-wrap;
            vertical-alignment: top; enabled: root.enabled;
            accessible-label: "Message Codex";
            key-pressed(e) => {
                if e.text == Key.Return && !e.modifiers.shift && self.preedit-text == "" {
                    if root.can-send { root.send(); } return accept;
                }
                return reject;
            }
            cursor-position-changed(pos) => {
                if pos.y + scroller.content-y < 0px { scroller.content-y = -pos.y; }
                else if pos.y + scroller.content-y > scroller.visible-height - 20px {
                    scroller.content-y = min(0px, scroller.visible-height - pos.y - 20px);
                }
            }
        }
    }
    if input.text == "" && input.preedit-text == "": Text {
        x: 18px; y: scroller.y; color: Theme.muted; text: "Message Codex…"; font-size: 16px; accessible-role: none;
    }

    plus := Action { x: 9px; y: parent.height - 51px; width: 40px; height: 40px; border-radius: 20px;
        label: "Add to message"; glyph: "\u{e710}"; icon-only: true; enabled: root.enabled;
        activate => {root.open-add(self.absolute-position.x,self.absolute-position.y,self.width,self.height);} }
    subagent-button := Action { x: plus.x + plus.width + 2px; y: parent.height - 48px; width: 95px; height: 34px;
        label: "Subagents"; selected: root.custom-subagents; accessible-description: root.custom-subagents ? "Chat override" : "Global defaults"; enabled: root.policy-enabled; activate => { root.subagents(); } }
    inference := InferencePicker {
        private property <length> right-edge: parent.width - (root.running ? 114px : 64px);
        width: min(self.preferred-width, self.right-edge - subagent-button.x - subagent-button.width - 6px); x: self.right-edge - self.width; y: parent.height - 48px;
        role-name: "Chat"; choices: root.choices; enabled: root.picking;
        open => { root.open-picker(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
    }
    if root.running: Action { x: parent.width - 108px; y: parent.height - 53px; width: 44px; height: 44px;
        label: "Stop response"; glyph: "\u{e71a}"; icon-only: true; activate => {root.stop();} }
    Action { x: parent.width - 58px; y: parent.height - 53px; width: 44px; height: 44px; border-radius: 22px;
        label: "Send message"; glyph: "\u{e74a}"; icon-only: true; primary: true;
        enabled: root.enabled && root.can-send; activate => {root.send();} }
}

export component Desk inherits Window {
    in property <[AlbumItem]> album;
    in property <[AlbumItem]> outputs;
    in property <string> album-error;
    in property <bool> capturing;
    private property <bool> album-open;
    private property <string> viewing-shot;
    private property <bool> return-to-outputs;
    callback refresh-album();
    callback take-screenshot();
    pure callback shot-image(string,bool) -> image;
    in-out property <bool> official-only: true;
    in property <[PickerOption]> attachments;
    callback attach(bool);
    callback remove-attachment(int);
    in-out property <bool> settings-open;
    in-out property <string> settings-tab: "Providers";
    in-out property <string> settings-provider: "Codex";
    in-out property <bool> browse-plugins;
    in property <[SettingRow]> settings-rows;
    in property <string> settings-status;
    in property <bool> settings-working;
    in-out property <string> settings-query;
    changed settings-query => {root.confirm-id = ""; root.search-settings(root.settings-query);}
    private property <string> source-input;
    private property <string> confirm-id;
    changed settings-open => { root.confirm-id = ""; }
    callback load-settings();
    callback settings-action(string,string);
    callback search-settings(string);
    function visit-settings(tab: string, provider: string) {
        root.confirm-id = "";
        if tab != root.settings-tab || provider != root.settings-provider {
            root.settings-query = ""; root.source-input = ""; root.browse-plugins = false;
        }
        root.settings-tab = tab; root.settings-provider = provider;
        root.load-settings();
    }
    title: project == "" ? "Workshop" : project + " · Workshop";
    preferred-width: 1080px; preferred-height: 740px; min-width: 740px; min-height: 530px;
    background: Theme.canvas; default-font-family: "Segoe UI";
    in property <string> project;
    in property <[string]> rows;
    in property <[ChatTurn]> turns;
    in property <MeterData> context-meter;
    in property <[MeterData]> usage-meters;
    in property <[WorkerRow]> workers;
    in property <PickerData> chat-choices;
    in-out property <bool> editing-chat-policy;
    in property <bool> inherit-policy;
    in property <bool> all-models;
    in property <string> allowed-model-names;
    private property <bool> inherited-policy: editing-chat-policy && inherit-policy;
    in property <bool> custom-subagents;
    in property <[PolicyModel]> policy-models;
    in property <[PickerOption]> cap-levels;
    in property <int> cap-index;
    callback change-policy(string,string);
    function open-policy(chat: bool) {
        root.editing-chat-policy = chat;
        root.change-policy("open", "");
        root.show-panel(OpenPanel.policy, composer.subagent-x, composer.subagent-y, composer.subagent-width, composer.subagent-height);
    }
    in property <bool> catalog-ready;
    in property <string> catalog-status;
    callback reload-models();
    callback choose-inference(bool,string);
    in property <bool> parallel-workers;
    in property <bool> checkpoint-only;
    in property <string> checkpoint;
    private property <bool> show-checkpoint;
    callback save-parallel(bool);
    callback stop-worker(int);
    private property <int> expanded-worker: -1;
    private property <bool> show-workers: true;
    private property <int> open-dispatch: -1;
    function toggle-worker(id: int) { root.expanded-worker = root.expanded-worker == id ? -1 : id; }
    changed selection => { root.open-panel = OpenPanel.closed; root.open-dispatch = -1; root.expanded-worker = -1; root.show-workers = true; root.show-checkpoint=false; }
    in property <string> partial;
    in property <int> selection: -1;
    in property <string> state-label;
    in property <string> model-name;
    in property <string> action;
    in property <bool> can-review;
    in property <bool> can-discard;
    in property <bool> can-resume;
    in property <bool> can-retry;
    in property <bool> busy;
    in property <bool> running;
    in-out property <string> draft;
    in property <string> notice;
    callback open-project();
    callback select-row(int);
    callback operate(string);
    callback updates-ready();
    callback page(bool,bool);
    in property <bool> earlier-messages;
    in property <bool> later-messages;
    in property <bool> older-chats;
    in property <bool> newer-chats;
    pure callback has-content(string) -> bool;
    private property <OpenPanel> open-panel: OpenPanel.closed;
    private property <length> anchor-x;
    private property <length> anchor-y;
    private property <length> anchor-right;
    private property <length> anchor-bottom;
    private property <int> highlighted;
    private property <length> default-extra: chat-choices.models.length > 0 && chat-choices.models[0].value == "Default model" ? 16px : 0px;
    function show-panel(which: OpenPanel, x: length, y: length, w: length, h: length) {
        root.anchor-x = x; root.anchor-y = y;
        root.anchor-right = x + w; root.anchor-bottom = y + h;
        root.open-panel = which;
    }
    public function show-outputs() {
        if pane.visible && root.project != "" {
            root.show-panel(OpenPanel.outputs, outputs-button.absolute-position.x, outputs-button.absolute-position.y,
                outputs-button.width, outputs-button.height);
        }
    }
    function view-shot(key: string) {
        root.return-to-outputs = root.open-panel == OpenPanel.outputs;
        root.open-panel = OpenPanel.closed;
        root.viewing-shot = key;
    }
    function close-shot() {
        root.viewing-shot = "";
        if root.return-to-outputs { root.show-outputs(); }
    }
    function dismiss-panel() {
        if root.open-panel == OpenPanel.effort || root.open-panel == OpenPanel.models { composer.focus-picker(); }
        else if root.open-panel == OpenPanel.policy {
            composer.focus-subagents();
        } else if root.open-panel == OpenPanel.add { composer.focus-add(); }
        else if root.open-panel == OpenPanel.usage { usage-button.focus(); }
        else if root.open-panel == OpenPanel.options { options.focus(); }
        else if root.open-panel == OpenPanel.outputs { outputs-button.focus(); }
        root.open-panel = OpenPanel.closed;
    }
    function select-model(i: int) {
        if i != root.chat-choices.model-index { root.choose-inference(true, root.chat-choices.models[i].value); }
        root.open-panel = OpenPanel.effort;
    }
    changed width => {root.open-panel = OpenPanel.closed;}
    changed height => {root.open-panel = OpenPanel.closed;}
    private property <bool> home: selection < 0;
    private property <bool> writable: home || running || can-resume;
    public function scroll-end() { transcript.content-y = min(0px, transcript.visible-height - transcript.content-height); }
    public function focus-draft() {composer.focus-input();}
    public pure function at-end() -> bool { return transcript.content-height + transcript.content-y <= transcript.visible-height + 30px; }
    function send-message() {
        if composer.can-send && root.writable && (!root.busy || root.running) {
            root.operate(root.home ? "submit" : root.running ? "steer" : "resume");
        }
    }
    function new-chat() {root.album-open = false; root.viewing-shot = ""; root.settings-open = false; root.select-row(-1); composer.focus-input();}
    init => { Palette.color-scheme = dark; }
    rail := Rectangle {
        x: 0px; y: 0px; width: root.width < 880px ? 192px : 224px; height: root.height; background: Theme.sidebar;
        VerticalLayout {
            padding-left: 14px; padding-right: 14px; padding-top: 22px; padding-bottom: 14px; spacing: 6px;
            HorizontalLayout { padding-left: 8px; height: 44px; spacing: 9px;
                Text { text: "Workshop"; color: Theme.text; font-weight: 600; font-size: 22px; vertical-alignment: center; }
            }
            if root.project != "": Action { label: "New chat"; glyph: "\u{e710}"; height: 40px; border-radius: 20px;
                enabled: !root.busy; activate => {root.new-chat();} }
            if root.rows.length > 0: HorizontalLayout { height: 41px; padding-left: 10px;
                Text { text: "Chats"; color: Theme.muted; font-size: 12px; vertical-alignment: bottom; }
            }
            ListView {
                for chat[i] in root.rows: Action { label: chat; selected: i == root.selection;
                    enabled: !root.busy; activate => {root.album-open = false; root.viewing-shot = ""; root.settings-open = false; root.select-row(i);} }
            }
            if root.older-chats || root.newer-chats: HorizontalLayout {
                if root.newer-chats: Action { label: "Newer chats"; enabled: !root.busy; activate => {root.page(true,false);} }
                if root.older-chats: Action { label: "Older chats"; enabled: !root.busy; activate => {root.page(true,true);} }
            }
            Action { label: "Screenshots"; glyph: "\u{e722}"; selected: root.album-open;
                activate => {root.album-open = !root.album-open; root.settings-open = false; root.open-panel = OpenPanel.closed; root.viewing-shot = ""; if root.album-open {root.refresh-album();}} }
            settings := Action {
                label: "Settings"; glyph: "\u{e713}"; selected: root.settings-open;
                activate => { root.album-open = false; root.viewing-shot = ""; root.settings-open = !root.settings-open;
                    if root.settings-open { root.open-panel = OpenPanel.closed; root.visit-settings(root.settings-tab,root.settings-provider); } }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Action { label: root.project == "" ? "Open project…" : root.project; glyph: "\u{e8b7}"; enabled: !root.busy; activate => {root.open-project();} }
        }
    }
    pane := Rectangle {
        visible: !root.settings-open && !root.album-open && root.viewing-shot == "";
        x: rail.width; width: root.width - self.x; height: root.height;
        private property <length> measure: min(720px, self.width - 56px);
        private property <length> folder-button-y: self.height / 2 - 32px;
        HorizontalLayout {
            visible: root.project != ""; x: 24px; y: 10px; width: parent.width - 48px; height: 40px; spacing: 14px;
            Text { text: root.selection >= 0 ? root.rows[root.selection] : "";
                color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; }
            if !root.writable && root.model-name != "" && pane.width > 720px: Text { text: root.model-name; color: Theme.muted;
                font-size: 13px; vertical-alignment: center; }
            usage-button := UsageSummary { context: root.context-meter; windows: root.usage-meters;
                open => { root.show-panel(OpenPanel.usage, self.absolute-position.x, self.absolute-position.y, self.width, self.height); } }
            options := Action {
                visible: !root.home && !root.busy; width: 36px; label: "Chat options"; glyph: "\u{e712}"; icon-only: true;
                activate => {root.show-panel(OpenPanel.options, self.absolute-position.x, self.absolute-position.y, self.width, self.height);}
            }
            outputs-button := Action {
                label: "Outputs"; glyph: "\u{e8b9}"; icon-only: pane.width < 600px;
                width: self.icon-only ? 36px : 108px; selected: root.open-panel == OpenPanel.outputs;
                activate => {if root.open-panel == OpenPanel.outputs { root.dismiss-panel(); } else { root.show-outputs(); }}
            }
        }
        if root.home && root.turns.length == 0: Text {
            x: composer.x + 2px; y: root.project == "" ? pane.folder-button-y - 72px : (composer.y - self.height) / 2;
            width: pane.measure; height: 55px;
            text: root.project == "" ? "Open a project to chat" : "What are we building?";
            horizontal-alignment: center; vertical-alignment: center; color: Theme.text; font-weight: 600;
            font-size: pane.width < 600px ? 29px : 34px;
        }
        if root.project == "": Action {
            x: composer.x; y: pane.folder-button-y; width: 145px;
            label: "Choose folder…"; glyph: "\u{e8b7}"; selected: true; enabled: !root.busy; activate => {root.open-project();}
        }
        team := ScrollView {
            x: (parent.width - self.width) / 2; y: 55px; width: pane.measure;
            visible: !root.home && root.workers.length > 0;
            height: self.visible ? min(team-body.preferred-height, parent.height * 0.32) : 0px;
            content-width: self.visible-width; content-height: team-body.preferred-height;
            team-body := WorkerGroup {
                width: team.visible-width;
                label: "Codex lead  ·  " + root.workers.length + (root.workers.length == 1 ? " worker" : " workers");
                workers: root.workers; open: root.show-workers; expanded-worker: root.expanded-worker;
                toggle => { root.show-workers = !root.show-workers; }
                choose-worker(id) => { root.toggle-worker(id); }
                stop-worker(id) => { root.stop-worker(id); }
            }
        }
        transcript := ScrollView {
            visible: !root.home || root.turns.length > 0; x: (parent.width - self.width) / 2; y: team.y + team.height + 11px; width: pane.measure;
            height: max(50px, (root.writable ? composer.y : closed.y) - self.y - 18px);
            content-width: self.visible-width; content-height: turns-layout.preferred-height;
            turns-layout := VerticalLayout {
                width: transcript.visible-width; padding-right: 8px; padding-top: 8px; padding-bottom: 10px; spacing: 25px; alignment: start;
                if !root.home && root.earlier-messages: Action { label: "Earlier messages"; activate => {root.page(false,true);} }
                for turn in root.turns: Rectangle {
                    height: turn.shot != "" ? 166px : turn.dispatch-id != 0 ? dispatch-group.preferred-height : body.preferred-height + (turn.from-user ? 22px : 0px);
                    if turn.shot != "": Action { width: min(248px,parent.width); x: parent.width - self.width; height: parent.height;
                        label: "Sent screenshot"; icon-only: true; selected: true;
                        Image { x: 6px; y: 6px; width: parent.width - 12px; height: 130px; source: root.shot-image(turn.shot,false); image-fit: contain; }
                        Text { x: 12px; y: 141px; text: "Sent screenshot"; font-size: 13px; color: Theme.text; }
                        activate => {root.view-shot(turn.shot);} }
                    dispatch-group := WorkerGroup {
                        visible: turn.dispatch-id != 0; width: parent.width;
                        height: self.preferred-height; label: turn.body; workers: turn.workers;
                        open: root.open-dispatch == turn.dispatch-id; expanded-worker: root.expanded-worker;
                        toggle => { root.open-dispatch = self.open ? -1 : turn.dispatch-id; }
                        choose-worker(id) => { root.toggle-worker(id); }
                        stop-worker(id) => { root.stop-worker(id); }
                    }
                    bubble := Rectangle {
                        visible: turn.dispatch-id == 0 && turn.shot == "";
                        width: turn.from-user ? min(parent.width * 0.84, max(46px, body.preferred-width + 32px)) : parent.width;
                        x: turn.from-user ? parent.width - self.width : 0px; height: parent.height;
                        background: turn.from-user ? Theme.surface : transparent; border-radius: 14px;
                        body := TextInput {
                            x: turn.from-user ? 16px : 0px; y: turn.from-user ? 11px : 0px;
                            width: parent.width - 2 * self.x; height: self.preferred-height;
                            text: turn.body; color: turn.delivery-notice ? Theme.muted : Theme.text; font-size: turn.delivery-notice ? 14px : 16px;
                            read-only: true; single-line: false; wrap: word-wrap;
                            accessible-label: turn.from-user ? "Your message" : turn.delivery-notice ? "Delivery notice" : "Codex reply";
                        }
                    }
                }
                if !root.home && !root.later-messages && root.checkpoint != "": VerticalLayout {
                    Action { label: "Project handoff"; glyph: root.show-checkpoint ? "\u{e70d}" : "\u{e76c}"; activate => {root.show-checkpoint=!root.show-checkpoint;} }
                    if root.show-checkpoint: Text { text: root.checkpoint; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                }
                if !root.home && root.later-messages: Action { label: "Newer messages"; activate => {root.page(false,false);} }
                if !root.later-messages && root.running && root.partial != "": TextInput {
                    text: root.partial; read-only: true; single-line: false; wrap: word-wrap;
                    color: Theme.text; font-size: 16px; accessible-label: "Codex reply";
                }
                if !root.later-messages && root.running && root.partial == "": Text { text: "Codex is working…"; color: Theme.muted; font-size: 14px; }
                if !root.home && (root.state-label == "Failed" || root.state-label == "Interrupted" || root.state-label == "Cancelled"): Text {
                    text: root.action; color: Theme.muted; font-size: 14px; wrap: word-wrap;
                }
            }
        }
        composer := Composer {
            visible: root.project != "" && root.writable;
            x: (parent.width - self.width) / 2; width: pane.measure;
            y: parent.height - self.height - feedback.height - 24px;
            value <=> root.draft; running: root.running; enabled: !root.busy || root.running; can-send: !root.capturing && (root.has-content(root.draft) || root.attachments.length > 0);
            attachments: root.attachments; remove-attachment(i) => {root.remove-attachment(i);}
            open-add(x,y,w,h) => {root.show-panel(OpenPanel.add,x,y,w,h);}
            choices: root.chat-choices; picking: !root.busy && root.catalog-ready;
            open-picker(x,y,w,h) => { root.show-panel(OpenPanel.effort, x, y, w, h); }
            custom-subagents: root.custom-subagents; policy-enabled: !root.busy; subagents => {root.open-policy(true);}
            send => { root.send-message(); } stop => { root.operate("cancel"); }
        }
        closed := Rectangle {
            visible: !root.home && !root.writable; x: (parent.width - self.width) / 2; width: pane.measure;
            height: 44px; y: parent.height - self.height - feedback.height - 24px;
            HorizontalLayout { alignment: center; spacing: 14px;
                Text { text: root.state-label; color: Theme.muted; font-size: 14px; vertical-alignment: center; }
                Action { label: "New chat"; glyph: "\u{e70f}"; enabled: !root.busy; selected: true; activate => {root.new-chat();} }
            }
        }
        feedback := Text {
            x: (parent.width - self.width) / 2; width: pane.measure; height: self.text == "" ? 0px : min(54px, self.preferred-height + 8px);
            y: parent.height - self.height - 5px; text: root.notice != "" ? root.notice : root.catalog-status; color: Theme.muted; wrap: word-wrap; overflow: elide; font-size: 13px;
        }
    }
    // Disable the outside hit area during the press so Slint delivers that same
    // event to the newly uncovered control. The opener itself toggles on release.
    if root.album-open && root.viewing-shot == "": Rectangle {
        x: rail.width; width: root.width - self.x; height: root.height;
        VerticalLayout { x: 28px; y: 28px; width: parent.width - 56px; height: parent.height - 48px; spacing: 20px;
            Text { text: "Screenshots"; color: Theme.text; font-size: 26px; font-weight: 600; }
            if root.album.length == 0 || root.album-error != "": Text { text: root.album-error != "" ? root.album-error : "Screenshots you send from a chat appear here."; color: Theme.muted; wrap: word-wrap; font-size: 15px; }
            gallery := ListView { vertical-stretch: 1;
                private property <int> columns: self.visible-width > 760px ? 3 : 2;
                for row[i] in ceil(root.album.length / gallery.columns): Rectangle {
                    height: 186px; width: gallery.visible-width;
                    for col[j] in gallery.columns: Rectangle {
                        private property <int> idx: i * gallery.columns + j;
                        x: j * (parent.width / gallery.columns); width: parent.width / gallery.columns - 12px; height: 173px;
                        if self.idx < root.album.length: Action { private property <AlbumItem> item: root.album[parent.idx];
                            width: parent.width; height: parent.height; label: "View screenshot " + item.date; icon-only: true;
                            Rectangle { x: 0px; y: 0px; width: parent.width; height: 128px; border-radius: 10px; background: Theme.surface; clip: true;
                                Image { width: parent.width; height: parent.height; source: root.shot-image(item.key,false); image-fit: contain; } }
                            Text { x: 2px; y: 134px; width: parent.width - 4px; height: 20px; text: item.project; overflow: elide; color: Theme.text; font-size: 14px; }
                            Text { x: 2px; y: 155px; width: parent.width - 4px; height: 16px; text: item.date; color: Theme.muted; font-size: 12px; }
                            activate => {root.view-shot(item.key);} }
                    }
                }
            }
        }
    }
    if root.viewing-shot != "": Flyout {
        x: rail.width; width: root.width - self.x; height: root.height;
        escape => {root.close-shot();} init => {back.focus();}
        back := Action { x: 20px; y: 18px; width: 90px; label: "Back"; glyph: "\u{e72b}"; activate => {root.close-shot();} }
        Image { x: 20px; y: 68px; width: parent.width - 40px; height: parent.height - 92px; image-fit: contain;
            source: root.shot-image(root.viewing-shot,true); accessible-label: "Full screenshot"; }
    }
    if root.settings-open: Rectangle {
        x: rail.width; width: root.width - self.x; height: root.height; background: Theme.canvas;
        VerticalLayout {
            x: (parent.width - self.width) / 2; width: min(710px, parent.width - 48px);
            y: 25px; height: parent.height - 45px; spacing: 12px;
            HorizontalLayout { height: 40px;
                Text { text: "Settings"; font-size: 26px; font-weight: 600; vertical-alignment: center; color: Theme.text; horizontal-stretch: 1; }
                Action { label: "Close settings"; icon-only: true; glyph: "\u{e711}"; width: 38px; activate => {root.settings-open = false; settings.focus();} }
            }
            HorizontalLayout { height: 36px; spacing: 5px; alignment: start;
                for tab in ["Providers", "Plugins", "Skills"]: Action { label: tab; width: tab == "Providers" ? 88px : 73px;
                    selected: root.settings-tab == tab; enabled: !root.settings-working;
                    activate => {root.visit-settings(tab,root.settings-provider);} }
            }
            Rectangle { height: 1px; background: Theme.line; }
            if root.settings-tab != "Providers": HorizontalLayout { height: 36px; spacing: 4px;
                for provider in ["Codex", "Claude Code"]: Action { label: provider; width: provider == "Codex" ? 70px : 109px;
                    selected: provider == root.settings-provider; enabled: !root.settings-working;
                    activate => {root.visit-settings(root.settings-tab,provider);} }
                Rectangle { horizontal-stretch: 1; }
                if root.settings-tab == "Plugins": Action { label: root.browse-plugins ? "Installed plugins" : "Browse plugins"; width: 125px;
                    enabled: !root.settings-working; activate => {root.browse-plugins = !root.browse-plugins; root.settings-query = ""; root.load-settings();} }
            }
            if root.settings-tab == "Providers": Text { text: "Sign in through your provider. Workshop uses Codex for chat."; color: Theme.muted; wrap: word-wrap; font-size: 14px; }
            if root.settings-tab != "Providers": HorizontalLayout { height: 36px; spacing: 6px;
                LineEdit { horizontal-stretch: 1; text <=> root.source-input; accessible-label: root.settings-tab == "Skills" ? "Skill source" : "Plugin source";
                    placeholder-text: root.settings-tab == "Skills" ? "GitHub skill folder URL" : "Plugin ID or marketplace source"; }
                Action { label: "Install"; selected: true; width: 66px; enabled: root.source-input != "" && !root.settings-working;
                    activate => {root.settings-action("install",root.source-input);} }
                Action { label: root.settings-tab == "Skills" ? "Folder…" : "Add marketplace"; width: root.settings-tab == "Skills" ? 81px : 139px;
                    enabled: !root.settings-working && (root.settings-tab == "Skills" || root.source-input != "");
                    activate => {root.settings-action(root.settings-tab == "Skills" ? "folder" : "marketplace",root.source-input);} }
            }
            if root.settings-tab != "Providers": HorizontalLayout { height: 34px; spacing: 8px;
                LineEdit { horizontal-stretch: 1; text <=> root.settings-query; placeholder-text: root.settings-tab == "Plugins" && root.browse-plugins ? "Search marketplace plugins" : "Filter " + (root.settings-tab == "Skills" ? "skills" : "plugins"); accessible-label: "Filter list"; }
                if root.settings-tab == "Plugins" && root.browse-plugins: CheckBox { text: "Official marketplaces"; checked <=> root.official-only;
                    toggled => {root.search-settings(root.settings-query);} }
            }
            if (root.settings-query != "" || root.browse-plugins) && root.settings-rows.length == 0 && root.settings-status == "": Text {
                text: root.settings-query != "" ? "No matches" : "No plugins from official marketplaces."; color: Theme.muted; font-size: 13px;
            }
            if root.settings-status != "": Text { text: root.settings-status; color: Theme.muted; font-size: 13px; wrap: word-wrap; max-height: 70px; overflow: elide; }
            preference-list := ListView { vertical-stretch: 1;
                for row in root.settings-rows: VerticalLayout { width: preference-list.visible-width; height: 60px;
                    HorizontalLayout { spacing: 6px; padding-left: 2px; padding-right: 7px;
                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                            Text { text: row.label; color: Theme.text; font-size: 15px; font-weight: 600; min-width: 0px; overflow: elide; }
                            Text { text: row.detail; color: Theme.muted; font-size: 12px; min-width: 0px; overflow: elide; }
                        }
                        if root.confirm-id == row.id: VerticalLayout { alignment: center; width: 74px;
                            Action { label: "Cancel"; width: 72px; height: 32px; activate => {root.confirm-id = "";} }
                        }
                        VerticalLayout { alignment: center; width: 100px;
                            if row.action != "": Action { label: root.confirm-id == row.id ? "Confirm" : row.button;
                                accessible-description: row.button + " " + row.label; width: 98px; height: 32px; selected: true;
                                enabled: !root.settings-working; activate => {
                                    if (row.action == "remove" || row.action == "logout") && root.confirm-id != row.id {root.confirm-id = row.id;}
                                    else {root.confirm-id = ""; root.settings-action(row.action,row.id);}
                                } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                }
            }
            Action { label: "Refresh"; width: 83px; enabled: !root.settings-working; activate => {root.load-settings();} }
        }
    }
    TouchArea {
        enabled: root.open-panel != OpenPanel.closed;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down &&
                (self.mouse-x < root.anchor-x || self.mouse-x >= root.anchor-right ||
                 self.mouse-y < root.anchor-y || self.mouse-y >= root.anchor-bottom) {
                root.open-panel = OpenPanel.closed;
            }
        }
        clicked => {root.dismiss-panel();}
    }
    if root.open-panel == OpenPanel.add: Flyout {
        x: root.anchor-x; y: root.anchor-y - self.height - 6px; width: 212px; height: add-rows.preferred-height;
        escape => {root.dismiss-panel();} init => {files.focus();}
        Rectangle { background: Theme.popup; border-color: Theme.line; border-width: 1px; border-radius: 16px; }
        add-rows := VerticalLayout { padding: 6px; spacing: 1px;
            files := Action { label: "Attach files…"; glyph: "\u{e723}"; activate => {root.dismiss-panel(); root.attach(false);} }
            Action { label: "Attach folder…"; glyph: "\u{e8b7}"; activate => {root.dismiss-panel(); root.attach(true);} }
            Rectangle { height: 1px; background: Theme.line; }
            Action { label: "Paste text"; glyph: "\u{e77f}"; activate => {root.dismiss-panel(); composer.paste-text();} }
            Action { label: "Take screenshot"; glyph: "\u{e722}"; enabled: !root.capturing; activate => {root.dismiss-panel(); root.take-screenshot();} }
        }
    }
    if root.open-panel == OpenPanel.outputs: Flyout {
        x: root.anchor-right - self.width; y: root.anchor-bottom + 6px;
        width: 284px; height: 96px + (root.outputs.length == 0 ? 47px : min(root.outputs.length, 4) * 64px);
        escape => {root.dismiss-panel();} init => {self.focus();}
        Rectangle { background: Theme.popup; border-color: Theme.line; border-width: 1px; border-radius: 16px; }
        VerticalLayout { padding: 8px; spacing: 3px;
            HorizontalLayout { height: 36px; padding-left: 8px;
                Text { text: "Outputs"; vertical-alignment: center; font-weight: 600; font-size: 15px; color: Theme.text; } }
            if root.outputs.length == 0: HorizontalLayout { padding-left: 8px; padding-right: 8px; vertical-stretch: 1;
                Text { text: "Screenshots you send in this chat appear here."; wrap: word-wrap; font-size: 13px; color: Theme.muted; } }
            if root.outputs.length > 0: output-list := ListView {
                vertical-stretch: 1;
                for item[i] in root.outputs: output-row := Action {
                    width: output-list.visible-width; height: 64px; icon-only: true;
                    private property <int> number: root.outputs.length - i;
                    label: "Open screenshot " + self.number; accessible-description: item.date;
                    Rectangle { x: 8px; y: 8px; width: 72px; height: 48px; background: Theme.sidebar; border-radius: 7px; clip: true;
                        Image { width: parent.width; height: parent.height; source: root.shot-image(item.key,false); image-fit: cover; } }
                    VerticalLayout { x: 92px; y: 0px; width: parent.width - 100px; height: parent.height; alignment: center; spacing: 2px;
                        Text { text: "Screenshot " + output-row.number; color: Theme.text; font-size: 14px; }
                        Text { text: item.date; color: Theme.muted; font-size: 12px; }
                    }
                    activate => {root.view-shot(item.key);}
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Action { label: "View all screenshots"; glyph: "\u{e8b9}"; height: 34px;
                activate => {root.dismiss-panel(); root.album-open = true; root.refresh-album();} }
        }
    }
    if root.open-panel == OpenPanel.usage: Flyout {
        x: root.anchor-right - self.width; y: root.anchor-bottom + 4px;
        width: 236px; height: usage-rows.preferred-height; escape => {root.dismiss-panel();} init => {self.focus();}
        Rectangle { background: Theme.popup; border-radius: 15px; border-width: 1px; border-color: Theme.line; }
        usage-rows := VerticalLayout {
            padding: 14px; spacing: 9px;
            HorizontalLayout {
                Text { text: "Context window"; color: Theme.text; font-size: 14px; horizontal-stretch: 1; }
                RemainingValue { fraction: root.context-meter.remaining; }
            }
            Text { text: root.context-meter.detail; color: Theme.muted; font-size: 12px; }
            Rectangle { height: 1px; background: Theme.line; }
            for window in root.usage-meters: HorizontalLayout {
                Text { text: window.detail; color: Theme.text; font-size: 14px; horizontal-stretch: 1; }
                RemainingValue { fraction: window.remaining; }
            }
            if root.usage-meters.length == 0: Text { text: "Account limits unavailable"; color: Theme.muted; font-size: 13px; }
        }
    }
    if root.open-panel == OpenPanel.options: Flyout {
        x: root.anchor-right - self.width; y: root.anchor-bottom + 4px; width: 194px;
        height: option-rows.preferred-height; escape => {root.dismiss-panel();} init => {self.focus();}
        Rectangle { background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: 16px; }
        option-rows := VerticalLayout { padding: 6px; spacing: 2px;
            Text { text: root.state-label; color: Theme.muted; font-size: 12px; height: 25px; vertical-alignment: center; }
            if root.can-review: Action { label: root.checkpoint-only ? "Accept decisions" : "Accept change"; activate => {root.operate("accept"); root.open-panel = OpenPanel.closed;} }
            if root.can-retry: Action { label: "Retry in new chat"; activate => {root.operate("retry"); root.open-panel = OpenPanel.closed;} }
            if root.can-discard: Action { label: "Discard change"; activate => {root.operate("discard"); root.open-panel = OpenPanel.closed;} }
        }
    }
    if root.open-panel == OpenPanel.effort: Flyout {
        width: 320px; height: 136px; x: clamp(root.anchor-right - self.width, 8px, root.width - self.width - 8px); y: root.anchor-y - self.height - 6px;
        escape => {root.dismiss-panel();} init => {if root.chat-choices.efforts.length > 1 {track.focus();} else {header.focus();}}
        Rectangle { background: Theme.popup; border-radius: 21px; border-width: 1px; border-color: Theme.line; }
        header := Action {
            x: 3px; y: 3px; width: parent.width - 6px; height: 76px; border-radius: 18px;
            icon-only: true; label: "Chat model";
            accessible-description: effort-title.text + ", " + root.chat-choices.current-model;
            activate => { root.highlighted = root.chat-choices.model-index; root.open-panel = OpenPanel.models; }
            VerticalLayout {
                x: 16px; width: parent.width - 32px; height: parent.height; alignment: center; spacing: 3px;
                effort-title := Text {
                    text: track.shown >= 0 ? root.chat-choices.efforts[track.shown].label : root.chat-choices.current-effort;
                    horizontal-alignment: center; color: Theme.text; font-size: 20px; font-weight: 600; accessible-role: none;
                }
                Text { text: root.chat-choices.current-model + "  ›"; horizontal-alignment: center; overflow: elide;
                    color: Theme.muted; font-size: 14px; accessible-role: none; }
            }
        }
        track := EffortTrack { x: 15px; y: header.y + header.height + 4px; width: parent.width - 30px; height: 40px;
            visible: root.chat-choices.efforts.length > 0;
            levels: root.chat-choices.efforts; selected: root.chat-choices.effort-index; name: "Chat reasoning effort";
            dismiss => {root.dismiss-panel();}
            commit(i) => { if i != root.chat-choices.effort-index { root.choose-inference(false,root.chat-choices.efforts[i].value); } } }
        if root.chat-choices.efforts.length == 0: Text { x: 12px; y: track.y; width: parent.width - 24px; height: 30px;
            text: "No effort levels available"; color: Theme.muted; horizontal-alignment: center; }
    }
    if root.open-panel == OpenPanel.models: Flyout {
        width: 320px; height: min(350px, root.anchor-y - 8px, 54px + root.default-extra + root.chat-choices.models.length * 38px); x: clamp(root.anchor-right - self.width, 8px, root.width - self.width - 8px); y: root.anchor-y - self.height - 6px;
        escape => {root.dismiss-panel();} init => {navigation.focus();}
        Rectangle { background: Theme.popup; border-radius: 21px; border-width: 1px; border-color: Theme.line; }
        Text { x: 18px; y: 13px; height: 24px; text: "Select model"; color: Theme.muted; font-size: 14px; }
        list := ScrollView { x: 8px; y: 40px; width: parent.width - 16px; height: parent.height - 51px;
            content-width: self.visible-width; content-height: model-rows.preferred-height;
            model-rows := VerticalLayout { width: list.visible-width;
                for m[i] in root.chat-choices.models: Action {
                    height: 38px + (i == 0 ? root.default-extra : 0px); label: m.label; selected: i == root.highlighted; border-radius: 14px;
                    detail: m.value == "Default model" ? "Use the configured Codex model" : "";
                    accessible-description: i == root.chat-choices.model-index ? "Selected" : "";
                    if i == root.chat-choices.model-index: Text { x: parent.width - 32px; width: 22px; vertical-alignment: center;
                        color: Theme.text; font-size: 14px; text: "\u{e73e}"; font-family: "Segoe MDL2 Assets"; accessible-role: none; }
                    activate => { root.select-model(i); }
                }
            }
            function reveal() {
                let top = root.highlighted * 38px + (root.highlighted > 0 ? root.default-extra : 0px);
                if top + self.content-y < 0px { self.content-y = -top; }
                else if top + 38px + self.content-y > self.visible-height { self.content-y = self.visible-height - top - 38px; }
            }
            init => { self.reveal(); }
        }
        navigation := FocusScope {
            focus-on-click: false;
            key-pressed(e) => {
                if e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Home || e.text == Key.End {
                    root.highlighted = clamp(e.text == Key.Home ? 0 : e.text == Key.End ? root.chat-choices.models.length - 1 :
                        root.highlighted + (e.text == Key.DownArrow ? 1 : -1), 0, root.chat-choices.models.length - 1);
                    list.reveal(); return accept;
                }
                if e.text == Key.Return || e.text == Key.Space {
                    root.select-model(root.highlighted); return accept;
                }
                if e.text == Key.Escape { root.dismiss-panel(); return accept; }
                return reject;
            }
        }
    }
    if root.open-panel == OpenPanel.policy: Flyout {
        x: clamp(root.anchor-x, 8px, root.width - self.width - 8px);
        y: max(8px, root.anchor-y - 6px - self.height);
        width: 292px; height: content.preferred-height; escape => {root.dismiss-panel();} init => {done.focus();}
        Rectangle { background: Theme.popup; border-radius: 15px; border-width: 1px; border-color: Theme.line; }
        content := VerticalLayout { padding: 12px; spacing: 5px;
            HorizontalLayout { height: 30px;
                Text { text: root.editing-chat-policy ? "Chat subagents" : "Subagent defaults";
                    font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                done := Action { label: "Done"; width: 58px; height: 30px; activate => {root.dismiss-panel();} }
            }
            if root.editing-chat-policy: CheckBox { text: "Use global defaults"; checked: root.inherit-policy;
                toggled => { root.change-policy(self.checked ? "inherit" : "customize",""); } }
            Text { text: "Allowed models"; color: Theme.text; font-size: 14px; font-weight: 600; }
            if root.inherited-policy: Text {
                text: root.allowed-model-names; color: Theme.muted; font-size: 13px;
                wrap: word-wrap; overflow: elide; max-height: 38px;
            }
            if !root.inherited-policy: models := ScrollView {
                height: min(model-list.preferred-height, 108px); content-width: self.visible-width; content-height: model-list.preferred-height;
                model-list := VerticalLayout { width: models.visible-width - 5px; spacing: 0px; alignment: start;
                    Action { label: "Any available model"; height: 30px;
                        if root.all-models: Text { x: parent.width - 24px; width: 20px; text: "✓"; color: Theme.text; vertical-alignment: center; }
                        accessible-checkable: true; accessible-checked: root.all-models;
                        activate => {root.change-policy("model","");} }
                    for model in root.policy-models: Action { label: model.label; height: 30px;
                        if model.selected: Text { x: parent.width - 24px; width: 20px; text: "✓"; color: Theme.text; vertical-alignment: center; }
                        accessible-checkable: true; accessible-checked: model.selected;
                        activate => {root.change-policy("model",model.value);} }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            HorizontalLayout { height: 22px;
                Text { text: "Maximum effort"; font-size: 14px; color: Theme.text; font-weight: 600; horizontal-stretch: 1; }
                Text { text: root.cap-index >= 0 && root.cap-index < root.cap-levels.length ? root.cap-levels[root.cap-index].label : "";
                    color: Theme.muted; font-size: 14px; }
            }
            if !root.inherited-policy: EffortTrack { height: 34px; name: "Maximum subagent effort";
                enabled: root.cap-levels.length > 1;
                opacity: self.enabled ? 1 : 0.45; levels: root.cap-levels; selected: root.cap-index;
                commit(i) => { if self.enabled {root.change-policy("effort",root.cap-levels[i].value);} }
                dismiss => {root.dismiss-panel();} }
            if !root.editing-chat-policy: CheckBox { checked: root.parallel-workers; text: "Allow two workers in this project"; toggled => {root.save-parallel(self.checked);} }
            if !root.editing-chat-policy || !root.catalog-ready: Action { label: "Refresh models"; enabled: root.catalog-status != "Loading models…"; activate => {root.reload-models();} }
            Action { label: root.editing-chat-policy ? "Edit global defaults" : "Back to chat settings"; activate => {root.open-policy(!root.editing-chat-policy);} }
        }
    }

}
