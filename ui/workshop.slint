import { GoalEditor, GoalSummary } from "goal.slint";
import { PickerOption, PolicyModel, EffortTrack, AgentPolicyFields } from "agent-policy.slint";
export { PickerOption, PolicyModel, PolicyChoices } from "agent-policy.slint";
import { TaskEditor, TaskControls } from "task-settings.slint";
export { TaskControls, TaskProvider, TaskModelPage } from "task-settings.slint";
import { Theme, ThemeColors, Action, RowAction, ActivityLine } from "common.slint";
import { ReplyView, Transcript } from "transcript.slint";
export { Transcript, BlockKind, ReplyBlock } from "transcript.slint";
export { ThemeColors } from "common.slint";
import { AppearancePage } from "appearance.slint";
import { WorkQueuePage, WorkRow } from "work-queue.slint";
export { WorkRow } from "work-queue.slint";
import { SketchPad, Sketch } from "sketch.slint";
import { Comparison, ComparisonPage } from "comparison.slint";
export { Comparison } from "comparison.slint";
export { Sketch } from "sketch.slint";
export { Appearance, ThemeChoice } from "appearance.slint";
import { RailAction, WorkshopMark, StudioNavigation, ChatHistoryRow, DeleteChatDialog } from "navigation.slint";
import { PackPage } from "asset-packs.slint";
export { AssetPacks, PackRow, PackMember } from "asset-packs.slint";
import { Studio, StudioPage, ModelInspector } from "studio.slint";
export { Studio, StudioItem } from "studio.slint";
import { ListView, ScrollView, Palette, CheckBox, LineEdit } from "std-widgets.slint";

export struct WorkerRow { id: int, title: string, state: string, assignment: string, detail: string, criteria: string, dependencies: string, inference: string, limits: string, stats: string, running: bool }
export struct ChatTurn { row-key: string, from-user: bool, delivery-notice: bool, goal-finished: bool, body: string, dispatch-id: int, workers: [WorkerRow], shot: string, sketch: image, image-path: string, original-path: string, markup-path: string, previous-output: bool, asset-id: int, asset-sound: bool, asset-model: bool, maker: string }
export struct OutputItem { sound: bool, title: string, open-label: string, detail: string, shot: string, path: string, preview: string, asset-id: int }
export struct AlbumItem { key: string, project: string, date: string }
export struct SettingRow { id: string, label: string, detail: string, action: string, button: string, task-count: string }
export enum PluginSection { recommended, installed, marketplace }
export struct MeterData { label: string, remaining: float, detail: string }
export struct PickerData {
    models: [PickerOption], efforts: [PickerOption], model-index: int, effort-index: int,
    current-model: string, current-effort: string
}

enum OpenPanel { closed, add, effort, models, policy, usage, options, outputs, activity, delivery }

component Flyout inherits FocusScope {
    callback escape();
    focus-on-click: false;
    capture-key-pressed(e) => {
        if e.text == Key.Escape {root.escape(); return accept;}
        return reject;
    }
    TouchArea {} // Keep clicks on empty panel space inside the panel.
    @children
}

component RemainingValue inherits Text {
    in property <float> fraction;
    text: fraction < 0 ? "—" : round(fraction * 100) + "%";
    color: fraction < 0 ? Theme.muted : fraction < 0.5
        ? Theme.halfway.mix(Theme.scarce, fraction * 2)
        : Theme.ample.mix(Theme.halfway, (fraction - 0.5) * 2);
    vertical-alignment: center; horizontal-alignment: right; font-size: 13px; font-weight: 600;
}

component InlineReading inherits HorizontalLayout {
    in property <MeterData> reading;
    spacing: 4px; alignment: start; horizontal-stretch: 0;
    Text { text: root.reading.label; color: Theme.muted; vertical-alignment: center; font-size: 13px; }
    RemainingValue { fraction: root.reading.remaining; }
}

component UsageSummary inherits Action {
    in property <MeterData> context;
    in property <[MeterData]> windows;
    in property <bool> loading;
    label: "Context and usage"; icon-only: true;
    width: line.preferred-width;
    callback open();
    activate => { root.open(); }
    line := HorizontalLayout {
        height: root.height; padding-left: 8px; padding-right: 8px; spacing: 12px; alignment: start;
        InlineReading { height: root.height; reading: root.context; }
        for window in root.windows: InlineReading { height: root.height; reading: window; }
        if root.windows.length == 0: Text {
            text: root.loading ? "Usage …" : "Usage —"; color: Theme.muted; vertical-alignment: center; font-size: 13px;
        }
    }

}

component WorkerGroup inherits VerticalLayout {
    in property <string> label;
    in property <[WorkerRow]> workers;
    in property <bool> open;
    in property <int> expanded-worker;
    callback toggle();
    callback choose-worker(int);
    callback stop-worker(int);
    callback direct-worker(int,string);
    alignment: start; spacing: 0px;
    RowAction {
        label: root.label;
        glyph: root.open ? "\u{e70d}" : "\u{e76c}"; glyph-color: Theme.keyword; label-font: Theme.mono;
        outlined: true;
        accessible-expanded: root.open;
        activate => { root.toggle(); }
    }
    if root.open: VerticalLayout {
        padding-left: 17px; spacing: 0px;
        for agent[index] in root.workers: HorizontalLayout {
            spacing: 6px;
            Rectangle { width: 10px;
                Rectangle { width: 1px; height: index == root.workers.length - 1 ? 18px : parent.height; background: Theme.line; }
                Rectangle { y: 18px; width: parent.width; height: 1px; background: Theme.line; }
            }
            VerticalLayout { spacing: 0px;
                HorizontalLayout { spacing: 7px;
                    RowAction { label: agent.title; horizontal-stretch: 1; selected: root.expanded-worker == agent.id;
                        accessible-expanded: root.expanded-worker == agent.id; activate => {root.choose-worker(agent.id);}
                    }
                    Text { text: agent.state; color: Theme.state-color(agent.state); vertical-alignment: center; font-family: Theme.mono; font-size: 13px; }
                }
                VerticalLayout { padding-left: 10px; padding-bottom: 5px;
                    Text { text: agent.inference; color: Theme.symbol; font-size: 13px; wrap: word-wrap; }
                }
                if root.expanded-worker == agent.id: VerticalLayout { padding-left: 10px; padding-bottom: 9px; spacing: 5px;
                    Text { text: agent.limits; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                    Text { text: agent.assignment; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                    if agent.detail != "" && agent.detail != agent.assignment: Text { text: agent.detail; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                    if agent.criteria != "": Text { text: "Acceptance · " + agent.criteria; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                    if agent.dependencies != "": Text { text: "Depends on · " + agent.dependencies; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                    Text { text: agent.stats; color: Theme.symbol; font-family: Theme.mono; font-size: 12px; wrap: word-wrap; }
                    if agent.running: HorizontalLayout { alignment: start; spacing: 6px;
                        Action { label: "Send direction"; activate => {root.direct-worker(agent.id,agent.title);} }
                        Action { label: "Stop worker"; activate => {root.stop-worker(agent.id);} }
                    }
                }
            }
        }
    }
}

component InferencePicker inherits Rectangle {
    in property <PickerData> choices;
    in property <string> role-name;
    in property <bool> enabled;
    callback open();
    preferred-width: pill-text.preferred-width + 42px;
    height: 34px; border-radius: 17px;
    background: enabled && hit.pressed ? Theme.line : hit.has-hover && enabled ? Theme.track : Theme.selected;
    border-width: trigger.has-focus ? 1px : 0px; border-color: Theme.text;
    accessible-role: button; accessible-label: role-name + " model and effort";
    accessible-description: choices.current-model + ", " + choices.current-effort;
    accessible-enabled: enabled; accessible-action-default => { if root.enabled { root.open(); } }
    forward-focus: trigger;
    pill-text := HorizontalLayout {
        x: 12px; width: parent.width - 36px;
        height: parent.height; spacing: 7px;
        Text { text: root.choices.current-model; color: root.enabled ? Theme.symbol : Theme.muted; overflow: elide; horizontal-stretch: 1;
            font-family: Theme.mono; font-size: 13px; vertical-alignment: center; min-width: 0px; accessible-role: none; }
        Text { text: root.choices.current-effort; color: Theme.muted; font-size: 12px; vertical-alignment: center; accessible-role: none; }
    }
    Text { x: parent.width - 22px; width: 14px; vertical-alignment: center; text: "\u{e70d}"; font-family: "Segoe MDL2 Assets"; color: Theme.muted; font-size: 10px; accessible-role: none; }
    hit := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { trigger.focus(); root.open(); } }
    trigger := FocusScope { focus-on-click: false; enabled: root.enabled; key-pressed(e) => {
        if e.text == Key.Return || e.text == Key.Space { root.open(); return accept; } return reject;
    } }
}

component Composer inherits Rectangle {
    in property <string> chat-provider: "Codex";
    in property <[PickerOption]> attachments;
    callback remove-attachment(int);
    callback open-add(length,length,length,length);
    in property <PickerData> choices;
    in property <bool> picking;
    callback open-picker(length,length,length,length);
    in-out property <string> value;
    in property <bool> enabled: true;
    in property <bool> running;
    in property <bool> can-send;
    in property <bool> goal-mode;
    in property <bool> suggesting-goal;
    callback accept-goal();
    callback cancel-goal();
    callback dismiss-suggestion();
    callback send();
    callback stop();
    in property <string> recipient;
    callback clear-recipient();
    callback delivery(length,length,length,length);
    callback subagents();
    in property <bool> policy-enabled;
    out property <length> subagent-x: subagent-button.absolute-position.x;
    out property <length> subagent-y: subagent-button.absolute-position.y;
    out property <length> subagent-width: subagent-button.width;
    out property <length> subagent-height: subagent-button.height;
    in property <bool> custom-subagents;
    in property <bool> project-worker-defaults;
    forward-focus: input;
    private property <length> attachment-height: min(2,root.attachments.length) * 32px;
    private property <length> recipient-height: root.recipient == "" ? 0px : 32px;
    height: 74px + min(108px, max(38px, input.preferred-height)) + root.attachment-height + root.recipient-height; border-radius: 23px; background: Theme.surface;
    border-width: 1px; border-color: input.has-focus ? Theme.accent.mix(Theme.line,0.65) : Theme.line;
    public function focus-input() { input.focus(); }
    public function focus-add() { plus.focus(); }
    public function paste-text() { input.focus(); input.paste(); }
    public function focus-picker() { inference.focus(); }
    public function focus-subagents() { subagent-button.focus(); }
    public function focus-delivery() { delivery-button.focus(); }
    if root.recipient != "": HorizontalLayout {
        x: 15px; y: 6px; height: 30px; width: parent.width - 30px; spacing: 6px;
        Text { text: "To " + root.recipient; color: Theme.accent; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Action { label: "Return to lead"; glyph: "\u{e711}"; icon-only: true; width: 32px; activate => {root.clear-recipient();} }
    }
    if root.attachments.length > 0: attached := ListView {
        x: 14px; y: 9px + root.recipient-height; width: parent.width - 28px; height: root.attachment-height;
        for file[i] in root.attachments: HorizontalLayout {
            width: attached.visible-width - 4px; height: 32px; spacing: 8px;
            Text { width: 20px; text: "\u{e723}"; font-family: "Segoe MDL2 Assets"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
            Text { text: file.label; accessible-description: file.value; horizontal-stretch: 1; min-width: 0px; vertical-alignment: center; overflow: elide; font-size: 13px; color: Theme.text; }
            Action { label: "Remove " + file.label; accessible-description: file.value; icon-only: true; glyph: "\u{e711}"; width: 32px; height: 32px; enabled: root.enabled;
                activate => {root.remove-attachment(i);} }
        }
    }
    scroller := ScrollView {
        x: 18px; y: 15px + root.attachment-height + root.recipient-height; width: parent.width - 36px; height: parent.height - 74px - root.attachment-height - root.recipient-height;
        content-width: self.visible-width; content-height: max(self.visible-height, input.preferred-height);
        input := TextInput {
            width: scroller.visible-width; height: max(scroller.visible-height, self.preferred-height);
            text <=> root.value; color: Theme.text; font-size: 16px;
            selection-background-color: Theme.selected; single-line: false; wrap: word-wrap;
            vertical-alignment: top; enabled: root.enabled;
            accessible-label: root.goal-mode ? "Goal objective" : "Message " + root.chat-provider;
            key-pressed(e) => {
                if self.preedit-text == "" && !e.modifiers.shift && !e.modifiers.control && !e.modifiers.alt {
                    if root.suggesting-goal && (e.text == Key.Tab || e.text == Key.Return) {
                        root.accept-goal(); return accept;
                    }
                    if e.text == Key.Escape {
                        if root.suggesting-goal { root.dismiss-suggestion(); return accept; }
                        if root.goal-mode { root.cancel-goal(); return accept; }
                    }
                }
                if e.text == Key.Return && !e.modifiers.shift && self.preedit-text == "" {
                    if root.can-send { root.send(); } return accept;
                }
                return reject;
            }
            cursor-position-changed(pos) => {
                if pos.y + scroller.content-y < 0px { scroller.content-y = -pos.y; }
                else if pos.y + scroller.content-y > scroller.visible-height - 20px {
                    scroller.content-y = min(0px, scroller.visible-height - pos.y - 20px);
                }
            }
        }
    }
    if input.text == "" && input.preedit-text == "": Text {
        x: 18px; y: scroller.y; color: Theme.muted; text: root.goal-mode ? "What should the agent work toward?" : "Message " + root.chat-provider + "…"; font-size: 16px; accessible-role: none;
    }

    plus := Action { x: 9px; y: parent.height - 51px; width: 40px; height: 40px; border-radius: 20px;
        label: "Add to message"; glyph: "\u{e710}"; icon-only: true; enabled: root.enabled;
        activate => {root.open-add(self.absolute-position.x,self.absolute-position.y,self.width,self.height);} }
    subagent-button := Action { x: plus.x + plus.width + 2px; y: parent.height - 48px;
        icon-only: root.width < (root.goal-mode ? 610px : 510px); width: self.icon-only ? 36px : 121px; height: 34px;
        glyph: "\u{e716}"; glyph-color: Theme.keyword;
        label: "Subagents"; selected: root.custom-subagents; accessible-description: root.custom-subagents ? "Chat override" : root.project-worker-defaults ? "Project defaults" : "Global defaults"; enabled: root.policy-enabled; activate => { root.subagents(); } }
    mode := Action {
        visible: root.goal-mode; x: subagent-button.x + subagent-button.width + 4px; y: subagent-button.y;
        width: self.visible ? 76px : 0px; height: 34px; glyph: "\u{e7c1}"; label: "Goal"; glyph-color: Theme.accent;
        accessible-label: "Exit goal mode"; accessible-description: "Keep the text as a regular message";
        activate => {root.cancel-goal();}
    }
    inference := InferencePicker {
        private property <length> right-edge: parent.width - (root.running ? (delivery-button.visible ? 144px : 114px) : 64px);
        width: min(self.preferred-width, self.right-edge - mode.x - mode.width - 6px); x: self.right-edge - self.width; y: parent.height - 48px;
        role-name: "Chat"; choices: root.choices; enabled: root.picking;
        open => { root.open-picker(self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
    }
    if root.running: Action { x: parent.width - (delivery-button.visible ? 140px : 108px); y: parent.height - 53px; width: 44px; height: 44px;
        label: "Stop response"; glyph: "\u{e71a}"; icon-only: true; activate => {root.stop();} }
    delivery-button := Action { visible: root.running && root.recipient == ""; x: parent.width - 89px; y: parent.height - 51px; width: 30px; height: 40px;
        label: "Send options"; glyph: "\u{e70d}"; icon-only: true; activate => {root.delivery(self.absolute-position.x,self.absolute-position.y,self.width,self.height);} }
    Action { x: parent.width - 58px; y: parent.height - 53px; width: 44px; height: 44px; border-radius: 22px;
        label: root.goal-mode ? "Start goal" : root.recipient != "" ? "Send to worker" : root.running ? "Steer now" : "Send message"; glyph: "\u{e74a}"; icon-only: true; primary: true;
        enabled: root.enabled && root.can-send; activate => {root.send();} }
}

export component Desk inherits Window {
    in property <string> goal-objective;
    in property <string> goal-status;
    in property <string> goal-detail;
    in-out property <bool> editing-goal;
    in-out property <bool> goal-mode;
    private property <bool> dismissed-goal;
    changed draft => { root.dismissed-goal = false; }
    pure callback goal-suggestion(string) -> bool;
    pure callback goal-draft-text(string) -> string;
    private property <bool> suggesting-goal: root.project != "" && root.writable && !root.busy && !root.goal-mode && !root.editing-goal
        && !root.dismissed-goal && root.direction-worker < 0 && root.open-panel == OpenPanel.closed && root.goal-suggestion(root.draft);
    public function begin-goal-draft() {
        root.open-panel = OpenPanel.closed;
        root.clear-recipient();
        root.goal-mode = true;
        root.draft = root.goal-draft-text(root.draft);
        composer.focus-input();
    }
    function leave-goal-draft() { root.goal-mode = false; root.dismissed-goal = true; composer.focus-input(); }
    private property <string> goal-input;
    callback run-goal(string);
    public function open-goal() {
        root.goal-input = root.goal-objective;
        root.open-panel = OpenPanel.closed;
        root.editing-goal = true;
        goal-editor.begin();
    }
    public function close-goal() {
        root.editing-goal = false;
        if root.goal-objective != "" {goal-summary.focus();}
        else {composer.focus-input();}
    }
    in property <[PickerOption]> queued;
    callback remove-queued(string);
    in-out property <int> direction-worker: -1;
    in-out property <string> direction-title;
    function direct-worker(id:int,title:string) {
        root.goal-mode=false; root.direction-worker=id; root.direction-title=title; root.open-panel=OpenPanel.closed; composer.focus-input();
    }
    public function clear-recipient() { root.direction-worker=-1; root.direction-title=""; }
    public function close-delivery() { if root.open-panel == OpenPanel.delivery {root.open-panel=OpenPanel.closed;} }
    in property <[AlbumItem]> album;
    in property <[OutputItem]> outputs;
    in property <string> album-error;
    in property <bool> capturing;
    private property <bool> album-open;
    in-out property <bool> studio-open;
    private property <string> viewing-shot;
    private property <bool> viewing-image;
    private property <int> viewing-asset;
    private property <bool> return-to-outputs;
    callback refresh-album();
    callback take-screenshot();
    pure callback shot-image(string,bool) -> image;
    pure callback file-image(string) -> image;
    in-out property <bool> official-only: true;
    in property <[PickerOption]> attachments;
    callback attach(bool);
    callback remove-attachment(int);
    in-out property <bool> settings-open;
    in property <bool> attention-enabled;
    callback save-attention(bool);
    out property <bool> watching-chat: root.chat-screen;
    out property <bool> watching-studio: root.studio-open;
    public function show-destination(studio: bool) {
        root.chat-query = "";
        root.visit(studio ? "studio" : "chat");
    }
    in-out property <string> settings-tab: "Providers";
    in-out property <string> settings-provider: "Codex";
    private property <string> expanded-provider;
    in property <[PolicyModel]> provider-roles;
    in-out property <string> permission-error;
    callback show-provider-roles(string);
    callback set-provider-role(string,int,bool);
    function expand-provider(label: string) {
        root.permission-error = "";
        root.expanded-provider = root.expanded-provider == label ? "" : label;
        if root.expanded-provider != "" { root.show-provider-roles(label); }
    }
    in-out property <PluginSection> plugin-section: PluginSection.recommended;
    private property <bool> recommendations: root.settings-tab == "Plugins" && root.plugin-section == PluginSection.recommended;
    private property <bool> browse-plugins: root.settings-tab == "Plugins" && root.plugin-section == PluginSection.marketplace;
    in property <[SettingRow]> settings-rows;
    in property <string> settings-status;
    in property <string> live-activity;
    in property <bool> settings-working;
    in property <string> settings-working-id;
    in property <bool> more-plugins;
    callback show-more-plugins();
    in-out property <string> settings-query;
    changed settings-query => {root.confirm-id = ""; root.search-settings(root.settings-query);}
    private property <string> source-input;
    private property <bool> source-open;
    private property <string> confirm-id;
    changed settings-open => { root.confirm-id = ""; }
    callback load-settings(bool);
    callback settings-action(string,string);
    callback search-settings(string);
    function visit-settings(tab: string, provider: string) {
        root.confirm-id = "";
        if tab != root.settings-tab || provider != root.settings-provider {
            root.settings-query = ""; root.source-input = ""; root.source-open = false;
            if tab != root.settings-tab { root.plugin-section = PluginSection.recommended; }
        }
        root.settings-tab = tab; root.settings-provider = provider;
        if tab == "Providers" && root.expanded-provider != "" { root.show-provider-roles(root.expanded-provider); }
        root.load-settings(false);
        if tab=="Tasks" { TaskControls.open(false,TaskControls.settings-area); }
    }
    function choose-providers() {
        if root.settings-open {root.visit-settings("Providers",root.settings-provider);}
        else {root.settings-tab="Providers"; root.visit("settings");}
    }
    title: project == "" ? "Workshop" : project + " · Workshop";
    preferred-width: 1080px; preferred-height: 740px; min-width: 740px; min-height: 530px;
    background: Theme.canvas; default-font-family: "Segoe UI";
    in property <string> project;
    in property <[PickerOption]> rows;
    in-out property <bool> work-open;
    in property <[WorkRow]> work-items;
    in-out property <int> work-offset;
    in property <bool> more-work;
    in property <string> work-error;
    callback load-work(int);
    in property <[ChatTurn]> turns;
    in property <MeterData> context-meter;
    in property <[MeterData]> usage-meters;
    in property <bool> usage-loading;
    callback refresh-usage();
    in property <[WorkerRow]> workers;
    in property <PickerData> chat-choices;
    in property <bool> worker-provider-available;
    in property <bool> worker-models-blocked;
    in property <bool> inherit-policy;
    in property <bool> project-worker-defaults;
    in property <bool> all-models;
    in property <string> allowed-model-names;
    in property <bool> custom-subagents;
    in property <[PolicyModel]> policy-models;
    in property <[PickerOption]> cap-levels;
    in property <int> cap-index;
    callback change-policy(string,string);
    function open-policy() {
        root.change-policy("open", "");
        root.show-panel(OpenPanel.policy, composer.subagent-x, composer.subagent-y, composer.subagent-width, composer.subagent-height);
    }
    in property <bool> catalog-ready;
    in property <string> catalog-status;
    callback reload-models();
    callback choose-inference(bool,string);
    in property <bool> parallel-workers;
    in property <bool> auto-delegate;
    in property <bool> checkpoint-only;
    in property <string> checkpoint;
    private property <bool> show-checkpoint;
    callback save-scheduling(bool,bool);
    callback stop-worker(int);
    private property <int> expanded-worker: -1;
    private property <bool> show-workers: true;
    private property <int> open-dispatch: -1;
    function toggle-worker(id: int) { root.expanded-worker = root.expanded-worker == id ? -1 : id; }
    changed selection => { root.editing-goal = false; root.open-panel = OpenPanel.closed; root.open-dispatch = -1; root.expanded-worker = -1; root.show-workers = true; root.show-checkpoint=false; }
    in property <string> partial;
    in property <int> selection: -1;
    in property <string> state-label;
    in property <string> chat-provider: "Codex";
    in property <string> model-name;
    in property <string> action;
    in property <bool> can-review;
    in property <bool> can-discard;
    in property <bool> can-resume;
    in property <bool> can-send-next;
    in property <bool> recoverable-goal;
    in property <bool> can-retry;
    in property <bool> busy;
    in property <bool> running;
    in-out property <string> draft;
    in property <string> notice;
    private property <string> feedback-text: root.notice != "" ? root.notice : root.catalog-status;
    callback open-project();
    callback select-row(int);
    callback operate(string);
    callback updates-ready();
    callback page(bool,bool);
    in property <bool> earlier-messages;
    in property <bool> later-messages;
    in property <bool> older-chats;
    in property <bool> newer-chats;
    pure callback has-content(string) -> bool;
    private property <OpenPanel> open-panel: OpenPanel.closed;
    private property <length> anchor-x;
    private property <length> anchor-y;
    private property <length> anchor-right;
    private property <length> anchor-bottom;
    private property <int> highlighted;
    private property <length> default-extra: chat-choices.models.length > 0 && chat-choices.models[0].value == "Default model" ? 16px : 0px;
    function show-panel(which: OpenPanel, x: length, y: length, w: length, h: length) {
        root.anchor-x = x; root.anchor-y = y;
        root.anchor-right = x + w; root.anchor-bottom = y + h;
        root.open-panel = which;
    }
    public function show-outputs() {
        if pane.visible && root.project != "" {
            root.show-panel(OpenPanel.outputs, outputs-button.absolute-position.x, outputs-button.absolute-position.y,
                outputs-button.width, outputs-button.height);
        }
    }
    function view-shot(key: string) {
        root.viewing-image = false; root.viewing-asset = 0;
        root.return-to-outputs = root.open-panel == OpenPanel.outputs;
        root.open-panel = OpenPanel.closed;
        root.viewing-shot = key;
    }
    function view-image(path: string, asset: int) {
        root.view-shot(path); root.viewing-image = true; root.viewing-asset = asset;
    }
    function close-shot() {
        root.viewing-shot = "";
        if root.return-to-outputs { root.show-outputs(); }
    }
    function dismiss-panel() {
        if root.open-panel == OpenPanel.effort || root.open-panel == OpenPanel.models { composer.focus-picker(); }
        else if root.open-panel == OpenPanel.policy {
            composer.focus-subagents();
        } else if root.open-panel == OpenPanel.delivery { composer.focus-delivery(); }
        else if root.open-panel == OpenPanel.add { composer.focus-add(); }
        else if root.open-panel == OpenPanel.usage { usage-button.focus(); }
        else if root.open-panel == OpenPanel.activity { activity-button.focus(); }
        else if root.open-panel == OpenPanel.options { options.focus(); }
        else if root.open-panel == OpenPanel.outputs { outputs-button.focus(); }
        root.open-panel = OpenPanel.closed;
    }
    function select-model(i: int) {
        if i != root.chat-choices.model-index { root.choose-inference(true, root.chat-choices.models[i].value); }
        root.open-panel = OpenPanel.effort;
    }
    changed width => {root.open-panel = OpenPanel.closed;}
    changed height => {root.open-panel = OpenPanel.closed;}
    private property <bool> home: selection < 0;
    private property <bool> writable: home || running || can-resume;
    public function position-transcript(bottom: bool) {
        transcript.follow-bottom = bottom;
        transcript.content-y = bottom ? transcript.end-y : 0px;
    }
    public function focus-draft() {composer.focus-input();}
    function send-message() {
        if root.suggesting-goal { root.begin-goal-draft(); }
        else if composer.can-send && root.writable && (!root.busy || root.running) {
            root.operate(root.direction-worker >= 0 ? "steer-worker" : root.home ? "submit" : root.running ? "steer" : "resume");
        }
    }
    function new-chat() {root.visit("chat"); root.chat-query=""; root.select-row(-1); composer.focus-input();}
    public function open-asset-draft() {
        if Comparison.visible {Comparison.close();}
        root.editing-goal = false; root.studio-open = false; root.album-open = false; root.work-open = false; root.viewing-shot = ""; root.return-to-outputs = false; root.open-panel = OpenPanel.closed;
        if !root.writable { root.new-chat(); }
        composer.focus-input();
    }

    private property <bool> compact: root.width < 940px;
    private property <bool> hide-context;
    private property <bool> compact-context;
    private property <bool> chat-screen: !Comparison.visible && !Studio.inspecting && !root.studio-open && !root.settings-open && !root.album-open && !root.work-open && root.viewing-shot == "";
    private property <bool> has-context: root.settings-open || (root.project != "" && !Comparison.visible && root.viewing-shot == "" && !root.album-open && !root.work-open && !Studio.inspecting);
    private property <bool> context-visible: root.has-context && (root.compact ? root.compact-context : !root.hide-context);
    private property <string> chat-query;
    private property <[PickerOption]> search-hits;
    callback find-chats(string) -> [PickerOption];
    callback select-hit(string);
    callback delete-chat(string);
    private property <string> delete-id;
    private property <string> delete-title;
    private property <string> restore-delete;
    private property <bool> delete-from-menu;
    function ask-delete(chat: PickerOption, from-menu: bool) {
        if root.busy || chat.value == "" { return; }
        root.open-panel = OpenPanel.closed; root.restore-delete = ""; root.delete-from-menu = from-menu;
        root.delete-title = chat.label; root.delete-id = chat.value;
    }
    public function refresh-chat-search() { root.search-hits = root.find-chats(root.chat-query); }
    changed chat-query => {root.refresh-chat-search();}
    public function reset-chat-navigation() {
        root.delete-id = ""; root.restore-delete = "";
        root.chat-query = ""; root.compact-context = false; root.work-open = false; root.clear-recipient();
        root.settings-origin = "chat"; root.settings-origin-shot = ""; root.editing-goal = false;
    }
    changed compact => {root.compact-context = false;}
    function toggle-context() {
        if root.compact {
            root.compact-context = !root.compact-context;
            if root.compact-context { context.focus(); }
        } else {root.hide-context = !root.hide-context;}
        root.open-panel = OpenPanel.closed;
    }
    private property <string> settings-origin: "chat";
    private property <string> settings-origin-shot;
    private property <bool> studio-destination: root.studio-open || (root.settings-open && root.settings-origin == "studio");
    changed studio-destination => {
        if !root.studio-destination {
            Studio.editing-run = false;
            if Studio.inspecting {Studio.command("close-inspector");}
        }
    }
    private property <bool> restoring-destination;
    function close-settings() {
        root.restoring-destination = true;
        root.visit(root.settings-origin);
        root.restoring-destination = false;
        root.viewing-shot = root.settings-origin-shot;
        settings.focus();
    }
    function visit(where: string) {
        if Studio.inspecting && where != "settings" && !root.restoring-destination {Studio.command("close-inspector");}
        if where == "settings" && !root.settings-open {
            root.settings-origin = Comparison.visible ? "comparison" : root.studio-open ? "studio" : root.album-open ? "album" : root.work-open ? "work" : "chat";
            root.settings-origin-shot = root.viewing-shot;
        }
        root.editing-goal = false;
        if Comparison.visible && where != "settings" && where != "comparison" {Comparison.close();}
        root.open-panel = OpenPanel.closed; root.viewing-shot = "";
        root.studio-open = where == "studio"; root.settings-open = where == "settings"; root.album-open = where == "album";
        root.work-open = where == "work";
        if root.work-open {root.load-work(root.restoring-destination ? root.work-offset : 0);}
        root.compact-context = false;
        if root.studio-open {Studio.command("refresh"); if Studio.editing-run { TaskControls.open(true,Studio.area); }}
        if root.settings-open {root.visit-settings(root.settings-tab,root.settings-provider);}
        if root.album-open {root.refresh-album();}
    }
    public function apply-colors(colors: ThemeColors, is-light: bool) {
        Theme.colors = colors;
        Palette.color-scheme = is-light ? ColorScheme.light : ColorScheme.dark;
    }
    rail := Rectangle {
        x: 0px; y: 0px; width: nav.width + (root.context-visible && !root.compact ? context.width : 0px); height: root.height;
        nav := Rectangle { x: 0px; y: 0px; width: 76px; height: root.height; background: Theme.rail;
            VerticalLayout { padding-left: 6px; padding-right: 6px; padding-top: 15px; padding-bottom: 10px; spacing: 4px;
                Rectangle { height: 42px; WorkshopMark { x: (parent.width - self.width) / 2; } }
                if root.project != "": RailAction { caption: "New chat"; label: "New chat"; symbol: "\u{e710}"; enabled: !root.busy; activate => {root.new-chat();} }
                RailAction { caption: "Chats"; label: "Chats"; symbol: "\u{e8bd}"; selected: root.chat-screen || root.work-open;
                    activate => {if root.chat-screen {root.toggle-context();} else {root.visit("chat");}} }
                if root.project != "": RailAction { caption: "Tools"; label: "Project tools"; symbol: "\u{e90f}"; selected: root.studio-open;
                    activate => {if root.studio-open && root.compact {root.toggle-context();} else {root.visit(root.studio-open ? "chat" : "studio");}} }
                RailAction { caption: "Album"; label:"Screenshots"; symbol: "\u{e91b}"; selected: root.album-open;
                    activate => {root.visit(root.album-open ? "chat" : "album");} }
                Rectangle { vertical-stretch: 1; }
                sidebar-switch := RailAction { visible: root.has-context; height: self.visible ? 56px : 0px; caption: "Sidebar"; label: root.context-visible ? "Hide sidebar" : "Show sidebar";
                    symbol: "\u{e700}"; accessible-expanded: root.context-visible; activate => {root.toggle-context();} }
                settings := RailAction { caption: "Settings"; label: "Settings"; symbol: "\u{e713}"; selected: root.settings-open;
                    activate => {if root.settings-open {root.close-settings();} else {root.visit("settings");}} }
                RailAction { caption: "Project"; label: root.project == "" ? "Open project…" : root.project; symbol: "\u{e8b7}";
                    enabled: !root.busy; accessible-description: "Choose a project folder"; activate => {root.open-project();} }
            }
        }
    }
    pane := Rectangle {
        visible: root.chat-screen;
        x: rail.width; width: root.width - self.x; height: root.height;
        private property <length> measure: min(760px, self.width - (self.width < 610px ? 32px : 72px));
        Rectangle { y:55px; width:parent.width; height:1px; background: Theme.line; visible:root.project!=""; }
        toolbar := HorizontalLayout {
            visible: root.project != ""; x: 24px; y: 10px; width: parent.width - 48px; height: 40px; spacing: 14px;
            Text { text: root.selection >= 0 ? root.rows[root.selection].label : "New conversation";
                color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; }
            if !root.writable && root.model-name != "" && pane.width > 720px: Text { text: root.model-name; color: Theme.muted;
                font-size: 13px; vertical-alignment: center; }
            usage-button := UsageSummary { height: toolbar.height; context: root.context-meter; windows: root.usage-meters; loading: root.usage-loading;
                open => { root.refresh-usage(); root.show-panel(OpenPanel.usage, self.absolute-position.x, self.absolute-position.y, self.width, self.height); } }
            activity-button := Action { height: toolbar.height; visible:!root.home; label:"Activity"; glyph:"\u{e9d9}"; glyph-color: Theme.keyword; icon-only:pane.width < 720px;
                width: !self.visible ? 0px : self.icon-only ? 34px : 96px; selected:root.open-panel == OpenPanel.activity;
                activate=>{if root.open-panel == OpenPanel.activity {root.dismiss-panel();} else {root.show-panel(OpenPanel.activity,self.absolute-position.x,self.absolute-position.y,self.width,self.height);}} }
            options := Action {
                height: toolbar.height; visible: !root.home && !root.busy; width: self.visible ? 36px : 0px; label: "Chat options"; glyph: "\u{e712}"; icon-only: true;
                activate => {root.show-panel(OpenPanel.options, self.absolute-position.x, self.absolute-position.y, self.width, self.height);}
            }
            outputs-button := Action {
                height: toolbar.height; label: "Outputs"; glyph: "\u{e8b9}"; glyph-color: Theme.symbol; icon-only: pane.width < 600px;
                width: self.icon-only ? 36px : 108px; selected: root.open-panel == OpenPanel.outputs;
                activate => {if root.open-panel == OpenPanel.outputs { root.dismiss-panel(); } else { root.show-outputs(); }}
            }
        }

        if root.home && root.turns.length == 0 && !Sketch.expanded && !root.editing-goal: VerticalLayout {
            x: (parent.width - self.width) / 2; width: min(pane.measure, 590px);
            height: self.preferred-height; y: max(58px, ((root.project == "" ? pane.height : pad.y) - self.height) / 2);
            alignment: start; spacing: 14px;
            HorizontalLayout { alignment: start; height: 40px; spacing: 12px;
                WorkshopMark { width: 38px; height:38px; }
                if root.project != "": Text { text: root.project; color: Theme.accent; vertical-alignment: center;
                    font-family: Theme.mono; font-size: 14px; overflow: elide; min-width: 0px; }
            }
            Text { text: root.project == "" ? "Open a project" : "What are we building?"; font-size: pane.width < 580px ? 30px : 39px;
                color: Theme.text; font-weight: 600; wrap:word-wrap; }
            Text { text: root.project == "" ? "Choose a folder to start a chat and keep your project’s work together." :
                    "Ask " + root.chat-provider + " about the project, plan a change, or give the team a task."; color:Theme.muted; font-size:15px; wrap:word-wrap; }
            HorizontalLayout { alignment:start; spacing:10px; height:38px;
                if root.project == "": Action { label:"Choose folder…"; glyph:"\u{e8b7}"; primary:true; width:145px; enabled:!root.busy; activate=>{root.open-project();} }
                if root.project != "" && root.draft == "": Action { label:"Explore project"; glyph:"\u{e8b7}"; glyph-color: Theme.halfway; width:147px; outlined:true;
                    activate=>{root.draft="Give me a tour of this project and point me to the main entry points."; composer.focus-input();} }
                if root.project != "" && root.draft == "": Action { label:"Plan a change"; glyph:"\u{e9d5}"; glyph-color: Theme.keyword; width:146px; outlined:true;
                    activate=>{root.draft="Help me plan this change: "; composer.focus-input();} }
            }
        }
        goal-summary := GoalSummary {
            visible: !root.home && root.goal-objective != ""; x:(parent.width - self.width)/2; y:61px; width:pane.measure;
            height: self.visible ? 36px : 0px; objective:root.goal-objective; status:root.goal-status;
            accessible-expanded:root.editing-goal; activate=>{if root.editing-goal {root.close-goal();} else {root.open-goal();}}
        }
        transcript := ScrollView {
            in-out property <bool> follow-bottom: true;
            out property <length> end-y: min(0px, self.visible-height - self.content-height);
            private property <length> last-end;
            // Layout can change after a reply is stored, a preview loads, or the composer grows.
            changed end-y => {
                self.last-end = self.end-y;
                if self.follow-bottom { self.content-y = self.end-y; }
                else if self.content-y < self.end-y { self.content-y = self.end-y; }
            }
            changed content-y => {
                if self.last-end == self.end-y {
                    self.follow-bottom = self.content-y <= self.end-y + 1px;
                }
            }
            visible: !root.home || root.turns.length > 0; x: (parent.width - self.width) / 2; y: goal-summary.y + goal-summary.height; width: pane.measure;
            height: max(0px, queue-strip.y - self.y - 18px);
            content-width: self.visible-width; content-height: turns-layout.preferred-height;
            turns-layout := VerticalLayout {
                width: transcript.visible-width; padding-right: 8px; padding-top: 18px; padding-bottom: 10px; spacing: 24px; alignment: start;
                if !root.home && root.earlier-messages: Action { label: "Earlier messages"; activate => {root.page(false,true);} }
                for turn in root.turns: message := Rectangle {
                    private property <bool> reply: !turn.goal-finished && !turn.from-user && !turn.delivery-notice && turn.asset-id == 0 && turn.dispatch-id == 0 && turn.shot == "" && !self.has-sketch;
                    private property <bool> has-sketch: turn.sketch.width > 0;
                    private property <bool> formatted-user: turn.from-user && Transcript.formatted(turn.body);
                    private property <bool> enlarged;
                    private property <length> sketch-width: self.enlarged ? self.width - 32px : min(304px, self.width * 0.84 - 32px);
                    private property <length> image-height: min(self.enlarged ? 540px : 212px, self.sketch-width * turn.sketch.height / max(1,turn.sketch.width));
                    private property <length> preview-height: self.has-sketch ? self.image-height + 42px : 0px;
                    height: turn.goal-finished ? receipt.preferred-height : turn.asset-id > 0 ? asset-reply.preferred-height : turn.shot != "" ? 166px : turn.dispatch-id != 0 ? dispatch-group.preferred-height : self.reply ? reply-view.preferred-height : (self.formatted-user ? user-markdown.preferred-height : body.preferred-height) + (turn.from-user ? 22px : 0px) + self.preview-height;
                    receipt := HorizontalLayout {
                        visible:turn.goal-finished; width:parent.width; spacing:8px;
                        Text { text:"\u{e73e}"; font-family:"Segoe MDL2 Assets"; color:Theme.accent; vertical-alignment:top; accessible-role:none; }
                        Text { text:turn.body; color:Theme.text; font-size:14px; wrap:word-wrap; horizontal-stretch:1; }
                    }
                    asset-reply := VerticalLayout {
                        visible: turn.asset-id > 0; x: 0px; y: 0px; width: min(360px, parent.width); spacing: 5px;
                        Action {
                            height: min(218px, self.width * max(1,turn.sketch.height) / max(1,turn.sketch.width)); icon-only: true;
                            label: turn.asset-sound ? (Studio.playing-sound == turn.asset-id ? "Stop sound preview" : "Play sound preview") : turn.asset-model ? "Open model preview" : "Enlarge image"; background: Theme.sidebar; border-radius: 12px; clip: true;
                            Image { width: parent.width; height: parent.height; source: turn.sketch; image-fit: contain; }
                            activate => {if turn.asset-sound {Studio.asset-action(turn.asset-id,"play");} else if turn.asset-model {Studio.asset-action(turn.asset-id,"inspect");} else {root.view-image(turn.image-path,turn.asset-id);}}
                        }
                        Text { text: turn.body; color: Theme.text; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                        Text { text: (turn.asset-sound ? "Sound effect · WAV" : turn.asset-model ? "3D model · GLB" : "Image · PNG") + "  ·  " + turn.maker; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        HorizontalLayout { height: 32px; spacing: 3px; alignment: start;
                            if turn.asset-sound: Action { width: 100px; label: Studio.playing-sound == turn.asset-id ? "Stop sound" : "Play sound"; glyph: Studio.playing-sound == turn.asset-id ? "\u{e71a}" : "\u{e768}"; activate => {Studio.asset-action(turn.asset-id,"play");} }
                            if turn.asset-model: Action { width: 112px; label: "Inspect model"; activate => {Studio.asset-action(turn.asset-id,"inspect");} }
                            if !turn.asset-model && !turn.asset-sound: Action { width: 92px; label: "Annotate"; enabled: !root.busy || root.running; activate => {Sketch.annotate(turn.image-path,false);} }
                            if turn.original-path != "": Action { width: 81px; label: "Compare";
                                activate => {Comparison.open(turn.original-path,turn.markup-path,turn.image-path,turn.previous-output);} }
                            Action { width: 99px; label: turn.asset-sound ? "Save sound" : turn.asset-model ? "Save model" : "Save image"; activate => {Studio.asset-action(turn.asset-id,"export");} }
                        }
                    }
                    reply-view := ReplyView { visible: message.reply; width: parent.width;
                        height: self.preferred-height; body: message.reply ? turn.body : ""; provider: root.chat-provider; }
                    if turn.shot != "": Action { width: min(248px,parent.width); x: parent.width - self.width; height: parent.height;
                        label: "Sent screenshot"; icon-only: true; selected: true;
                        Image { x: 6px; y: 6px; width: parent.width - 12px; height: 130px; source: root.shot-image(turn.shot,false); image-fit: contain; }
                        Text { x: 12px; y: 141px; text: "Sent screenshot"; font-size: 13px; color: Theme.text; }
                        activate => {root.view-shot(turn.shot);} }
                    dispatch-group := WorkerGroup {
                        visible: turn.dispatch-id != 0; width: parent.width;
                        height: self.preferred-height; label: turn.body; workers: turn.workers;
                        open: root.open-dispatch == turn.dispatch-id; expanded-worker: root.expanded-worker;
                        toggle => { root.open-dispatch = self.open ? -1 : turn.dispatch-id; }
                        choose-worker(id) => { root.toggle-worker(id); }
                        stop-worker(id) => { root.stop-worker(id); }
                        direct-worker(id,title) => {root.direct-worker(id,title);}
                    }
                    bubble := Rectangle {
                        visible: !turn.goal-finished && !message.reply && turn.asset-id == 0 && turn.dispatch-id == 0 && turn.shot == "";
                        width: message.has-sketch ? min(parent.width, max(message.sketch-width + 32px, min(parent.width * 0.84,body.preferred-width + 32px))) : turn.from-user ? min(parent.width * 0.84, max(46px, body.preferred-width + 32px)) : parent.width;
                        x: turn.from-user ? parent.width - self.width : 0px; height: parent.height;
                        background: turn.from-user ? Theme.surface : transparent; border-radius: 14px;
                        if message.has-sketch: Action {
                            x: 16px; y: 11px; width: message.sketch-width; height: message.image-height;
                            label: turn.from-user ? (message.enlarged ? "Reduce sketch" : "Enlarge sketch") : (message.enlarged ? "Reduce image" : "Enlarge image"); icon-only: true;
                            Image { width: parent.width; height: parent.height; source: turn.sketch; image-fit: contain; }
                            activate => {message.enlarged = !message.enlarged;}
                        }
                        if message.has-sketch: Action {
                            x: 12px; y: message.image-height + 15px; width: 106px; height: 29px;
                            label: "Annotate"; glyph: "\u{e104}"; enabled: !root.busy || root.running;
                            activate => {Sketch.annotate(turn.image-path,false);}
                        }
                        if message.has-sketch && turn.original-path != "": Action {
                            x: 120px; y: message.image-height + 15px; width: 139px; height: 29px;
                            label: "Compare"; accessible-description: turn.previous-output ? "Compare with the previous chat image" : "Compare with the original";
                            activate => {Comparison.open(turn.original-path,turn.markup-path,turn.image-path,turn.previous-output);}
                        }
                        user-markdown := ReplyView { visible: message.formatted-user; x: 16px; y: 11px + message.preview-height;
                            width: parent.width - 32px; height: self.preferred-height; body: message.formatted-user ? turn.body : ""; }
                        body := TextInput {
                            visible: !message.formatted-user;
                            x: turn.from-user ? 16px : 0px; y: (turn.from-user ? 11px : 0px) + message.preview-height;
                            width: parent.width - 2 * self.x; height: self.preferred-height;
                            text: turn.body; color: turn.delivery-notice ? Theme.muted : Theme.text; font-size: turn.delivery-notice ? 14px : 16px;
                            read-only: true; single-line: false; wrap: word-wrap;
                            accessible-label: turn.from-user ? "Your message" : turn.delivery-notice ? "Delivery notice" : root.chat-provider + " reply";
                        }
                    }
                }
                if !root.home && root.later-messages: Action { label: "Newer messages"; activate => {root.page(false,false);} }
                if !root.later-messages && root.running && root.partial != "": ReplyView {
                    provider: root.chat-provider; body: root.partial; streaming: true;
                }
                if !root.later-messages && root.running && root.live-activity != "": ActivityLine { label: root.live-activity; }
                if !root.home && (root.state-label == "Failed" || root.state-label == "Interrupted" || root.state-label == "Cancelled"): Text {
                    text: root.action; color: Theme.state-color(root.state-label); font-size: 14px; wrap: word-wrap;
                }
            }
        }
        queue-strip := VerticalLayout {
            x: composer.x; width: composer.width;
            visible: root.queued.length > 0 && !root.home;
            height: self.visible ? 32px + min(root.queued.length,2) * 31px : 0px;
            y: (root.editing-goal ? goal-editor.y : pad.y) - self.height;
            HorizontalLayout { height: 30px; spacing: 8px;
                Text { text: "Queued (" + root.queued.length + ")"; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; font-size: 13px; }
                if !root.busy && root.can-send-next: Action { label: "Send next"; height: 30px; activate => {root.operate("send-next");} }
            }
            queue-list := ListView {
                for item in root.queued: HorizontalLayout { width: queue-list.visible-width; height: 31px; spacing: 6px;
                    Text { text: item.label; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; color: Theme.text; font-size: 13px; }
                    Action { label: "Remove queued message"; accessible-description: item.label; glyph: "\u{e711}"; icon-only: true; width: 32px; activate => {root.remove-queued(item.value);} }
                }
            }
        }
        pad := SketchPad {
            visible: composer.visible && composer.enabled && (Sketch.expanded || Sketch.has-content);
            x: composer.x; width: composer.width;
            height: !self.visible ? 0px : Sketch.expanded ? min(55px + (self.width - 20px) / max(0.001,Sketch.ratio), max(110px, composer.y - 74px), pane.height * 0.47) : 44px;
            y: composer.y - self.height - (self.visible ? 6px : 0px);
        }
        composer := Composer {
            chat-provider: root.chat-provider;
            visible: root.project != "" && !root.editing-goal;
            x: (parent.width - self.width) / 2; width: pane.measure;
            y: parent.height - self.height - feedback.height - 24px;
            goal-mode: root.goal-mode; suggesting-goal: root.suggesting-goal;
            accept-goal => {root.begin-goal-draft();} cancel-goal => {root.leave-goal-draft();} dismiss-suggestion => {root.dismissed-goal = true;}
            value <=> root.draft; running: root.running; enabled: !root.busy || root.running; can-send: root.writable && (!root.goal-mode || !root.busy) && !root.capturing && !Sketch.replacing && (root.has-content(root.draft) || (!root.goal-mode && (root.attachments.length > 0 || Sketch.has-content)));
            attachments: root.attachments; remove-attachment(i) => {root.remove-attachment(i);}
            open-add(x,y,w,h) => {root.show-panel(OpenPanel.add,x,y,w,h);}
            choices: root.chat-choices; picking: !root.busy && root.catalog-ready;
            open-picker(x,y,w,h) => { root.show-panel(OpenPanel.effort, x, y, w, h); }
            custom-subagents: root.custom-subagents; project-worker-defaults: root.project-worker-defaults; policy-enabled: !root.busy; subagents => {root.open-policy();}
            send => { root.send-message(); } stop => { root.operate("cancel"); }
            recipient: root.direction-title; clear-recipient => {root.clear-recipient();composer.focus-input();}
            delivery(x,y,w,h) => {root.show-panel(OpenPanel.delivery,x,y,w,h);}
        }
        if root.suggesting-goal: Action {
            x:composer.x; y:pad.y - self.height - 5px; width:composer.width; height:40px;
            label:"Goal"; accessible-description:"Set a goal to keep pursuing"; icon-only:true; tab-stop:false;
            border-width:1px; border-color:Theme.line; border-radius:16px; background:self.hovered ? Theme.selected : Theme.surface;
            HorizontalLayout { padding-left:14px; padding-right:12px; spacing:9px;
                Text { text:"\u{e7c1}"; font-family:"Segoe MDL2 Assets"; color:Theme.accent; vertical-alignment:center; accessible-role:none; }
                Text { text:"Goal"; color:Theme.text; font-size:15px; vertical-alignment:center; accessible-role:none; }
                Text { text:"Set a goal to keep pursuing"; color:Theme.muted; font-size:14px; vertical-alignment:center; horizontal-stretch:1; overflow:elide; accessible-role:none; }
            }
            activate=>{root.begin-goal-draft();}
        }
        goal-editor := GoalEditor {
            visible:root.editing-goal; x:composer.x; width:pane.measure; height:root.goal-detail != "" ? 242px : 202px;
            y:parent.height - self.height - feedback.height - 24px;
            objective:root.goal-objective; status:root.goal-status; detail:root.goal-detail; value <=> root.goal-input;
            writable:root.writable; busy:root.busy; valid:root.has-content(root.goal-input);
            can-retry:root.can-retry; can-recover:root.recoverable-goal; retry=>{root.operate("retry");}
            start(v)=>{root.run-goal(v);} close=>{root.close-goal();}
            pause=>{root.operate("pause-goal");} clear=>{root.operate("clear-goal");}
        }
        feedback := ScrollView {
            x: (parent.width - self.width) / 2; width: pane.measure; height: root.feedback-text == "" ? 0px : min(78px, feedback-copy.preferred-height + 6px);
            y: parent.height - self.height - 5px; content-width: self.visible-width; content-height: feedback-copy.preferred-height;
            feedback-copy := TextInput { width: feedback.width - 18px; height: self.preferred-height; read-only: true; single-line: false;
                text: root.feedback-text; color: Theme.muted; wrap: word-wrap; font-size: 13px; accessible-label: "Status message"; }

        }
    }
    if root.work-open: WorkQueuePage {
        x: rail.width; width: root.width - self.x; height: root.height;
        items: root.work-items; more: root.more-work; offset: root.work-offset; busy: root.busy; problem: root.work-error;
        back => {root.visit("chat");} refresh(offset) => {root.load-work(offset);}
        open(id) => {root.visit("chat"); if !root.busy {root.select-hit(id);} }
    }
    if root.studio-open && Studio.area == "Packs": PackPage { x: rail.width; width: root.width - self.x; height: root.height; can-reference: !root.busy; navigation-hidden: !root.context-visible; browse => { root.toggle-context(); } }
    if root.studio-open && Studio.area != "Packs" && !Studio.editing-run: StudioPage { x: rail.width; y: 0px; width: root.width - self.x; height: root.height; can-attach: !root.busy; navigation-hidden: !root.context-visible; browse=>{root.toggle-context();} }
    if Studio.inspecting && !root.studio-open && !root.settings-open: ModelInspector { x: rail.width; width: root.width - self.x; height: root.height; }
    if root.studio-open && Studio.editing-run: Rectangle {
        x:rail.width; width:root.width - self.x; height:root.height; background:Theme.canvas;
        VerticalLayout { x:24px; width:parent.width - 48px; y:20px; height:parent.height - 40px; spacing:12px;
            Action { height:36px; label:"Back to reports"; glyph:"\u{e72b}"; width:142px; activate=>{Studio.editing-run=false;} }
            TaskEditor { vertical-stretch:1; catalog-ready:root.catalog-ready; catalog-status:root.catalog-status;
                reload=>{root.reload-models();} back=>{Studio.editing-run=false;} choose-providers=>{root.choose-providers();} }
        }
    }
    if root.album-open && root.viewing-shot == "": Rectangle {
        x: rail.width; width: root.width - self.x; height: root.height;
        VerticalLayout { x: 28px; y: 28px; width: parent.width - 56px; height: parent.height - 48px; spacing: 20px;
            HorizontalLayout { height: 44px; spacing: 12px;
                Text { text: "Screenshot album"; color: Theme.text; font-size: 28px; font-weight: 600; horizontal-stretch:1; vertical-alignment:center; }
                if root.album.length > 0: Text { text:root.album.length + (root.album.length == 1 ? " screenshot" : " screenshots"); color:Theme.muted; vertical-alignment:center; font-size:13px; }
            }
            Rectangle { height:1px; background:Theme.line; }
            if root.album.length == 0 || root.album-error != "": VerticalLayout { vertical-stretch:1; alignment:center; spacing:10px;
                Text { text: root.album-error != "" ? "Couldn’t load screenshots" : "No screenshots yet"; horizontal-alignment:center; color: Theme.text; font-weight:600; font-size:22px; }
                Text { text: root.album-error != "" ? root.album-error : "In a chat, choose + and Take screenshot. Captures from every project appear here."; horizontal-alignment:center; color: Theme.muted; wrap: word-wrap; font-size: 15px; }
                if root.album-error != "": HorizontalLayout { alignment:center; Action { label:"Try again"; selected:true; width:96px; activate=>{root.refresh-album();} } }
            }
            if root.album.length > 0 && root.album-error == "": gallery := ListView { vertical-stretch: 1;
                private property <int> columns: clamp(floor(self.visible-width / 248px), 1, 4);
                for row[i] in ceil(root.album.length / gallery.columns): Rectangle {
                    height: 186px; width: gallery.visible-width;
                    for col[j] in gallery.columns: Rectangle {
                        private property <int> idx: i * gallery.columns + j;
                        x: j * (parent.width / gallery.columns); width: parent.width / gallery.columns - 12px; height: 173px;
                        if self.idx < root.album.length: Action { private property <AlbumItem> item: root.album[parent.idx];
                            width: parent.width; height: parent.height; label: "View screenshot " + item.date; icon-only: true;
                            Rectangle { x: 0px; y: 0px; width: parent.width; height: 128px; border-radius: 10px; background: Theme.surface; clip: true;
                                Image { width: parent.width; height: parent.height; source: root.shot-image(item.key,false); image-fit: contain; } }
                            Text { x: 2px; y: 134px; width: parent.width - 4px; height: 20px; text: item.project; overflow: elide; color: Theme.text; font-size: 14px; font-weight: 600; }
                            Text { x: 2px; y: 155px; width: parent.width - 4px; height: 16px; text: item.date; color: Theme.muted; font-family: Theme.mono; font-size: 12px; }
                            activate => {root.view-shot(item.key);} }
                    }
                }
            }
        }
    }
    if root.viewing-shot != "": Flyout {
        x: rail.width; width: root.width - self.x; height: root.height;
        escape => {root.close-shot();} init => {back.focus();}
        back := Action { x: 20px; y: 18px; width: 90px; label: "Back"; glyph: "\u{e72b}"; activate => {root.close-shot();} }
        if root.viewing-image && root.viewing-asset > 0: Action { x: parent.width - 250px; y: 18px; width: 100px; label: "Save image"; activate => {Studio.asset-action(root.viewing-asset,"export");} }
        Action { x: parent.width - 140px; y: 18px; width: 120px; label: "Annotate"; glyph: "\u{e104}"; selected: true; enabled: root.project != "" && (!root.busy || root.running); activate => {Sketch.annotate(root.viewing-shot,!root.viewing-image);} }
        Image { x: 20px; y: 68px; width: parent.width - 40px; height: parent.height - 92px; image-fit: contain;
            source: root.viewing-image ? root.file-image(root.viewing-shot) : root.shot-image(root.viewing-shot,true); accessible-label: root.viewing-image ? "Full image" : "Full screenshot"; }
    }
    if Comparison.visible: ComparisonPage {
        visible: !root.settings-open;
        x: rail.width; width: root.width - self.x; height: root.height; can-edit: !root.busy || root.running;
    }
    if root.settings-open: Rectangle {
        x: rail.width; width: root.width - self.x; height: root.height; background: Theme.canvas;
        VerticalLayout {
            x: (parent.width - self.width) / 2; width: root.settings-tab == "Tasks" ? parent.width - 48px : min(710px, parent.width - 48px);
            y: 25px; height: parent.height - 45px; spacing: 12px;
            HorizontalLayout { height: 40px;
                Text { text: root.settings-tab == "Tasks" ? "Task settings" : root.settings-tab; font-size: 28px; font-weight: 600; vertical-alignment: center; color: Theme.text; horizontal-stretch: 1; }
                if !root.context-visible: Action { label:"Settings sections"; glyph:"\u{e700}"; width:152px; activate=>{root.toggle-context();} }
                Action { label: "Close settings"; icon-only: true; glyph: "\u{e711}"; width: 38px; activate => {root.close-settings();} }
            }
            if root.settings-tab != "Tasks": Rectangle { height: 1px; background: Theme.line; }
            if root.settings-tab == "Plugins" || root.settings-tab == "Skills": HorizontalLayout { height: 36px; spacing: 4px;
                for provider in ["Codex", "Claude Code", "Antigravity"]: Action { label: provider; width: provider == "Codex" ? 70px : 109px;
                    selected: provider == root.settings-provider; enabled: !root.settings-working;
                    activate => {root.visit-settings(root.settings-tab,provider);} }
                Rectangle { horizontal-stretch: 1; }
                Action { label: "Install from source"; width: 145px; selected: root.source-open; accessible-expanded: root.source-open;
                    activate => {root.source-open = !root.source-open;} }
            }
            if root.settings-tab == "Plugins": HorizontalLayout { height: 36px; alignment: start; spacing: 4px;
                for section[i] in [PluginSection.recommended, PluginSection.installed, PluginSection.marketplace]: Action {
                    label: ["Recommended", "Installed", "Browse plugins"][i]; width: [130px,90px,132px][i];
                    accessible-label: self.label + (i == 1 ? " plugins" : ""); selected: root.plugin-section == section; enabled: !root.settings-working;
                    activate => { if root.plugin-section != section {
                        root.plugin-section = section; root.settings-query = ""; root.confirm-id = ""; root.load-settings(false);
                    } }
                }
            }
            if root.settings-tab == "Providers": Text { text: "Choose which tasks each provider can handle across your projects."; color: Theme.muted; wrap: word-wrap; font-size: 14px; }
            if root.settings-tab == "Providers" && root.permission-error != "": Text { text:root.permission-error; wrap:word-wrap; color:Theme.scarce; }
            if root.source-open && (root.settings-tab == "Plugins" || root.settings-tab == "Skills"): HorizontalLayout { height: 36px; spacing: 6px;
                LineEdit { horizontal-stretch: 1; text <=> root.source-input; accessible-label: root.settings-tab == "Skills" ? "Skill source" : "Plugin source";
                    placeholder-text: root.settings-tab == "Skills" ? "GitHub skill folder URL" : root.settings-provider == "Antigravity" ? "Plugin name, GitHub URL or local path" : "Plugin ID or marketplace source"; }
                Action { label: "Install"; selected: true; width: 66px; enabled: root.source-input != "" && !root.settings-working;
                    activate => {root.settings-action("install",root.source-input);} }
                if root.settings-tab == "Skills" || root.settings-provider != "Antigravity": Action { label: root.settings-tab == "Skills" ? "Folder…" : "Add marketplace"; width: root.settings-tab == "Skills" ? 81px : 139px;
                    enabled: !root.settings-working && (root.settings-tab == "Skills" || root.source-input != "");
                    activate => {root.settings-action(root.settings-tab == "Skills" ? "folder" : "marketplace",root.source-input);} }
            }
            if root.settings-tab == "Plugins" || root.settings-tab == "Skills": HorizontalLayout { height: 34px; spacing: 8px;
                LineEdit { horizontal-stretch: 1; text <=> root.settings-query; placeholder-text: root.recommendations ? "Search recommendations" : root.browse-plugins ? "Search marketplace plugins" : "Filter " + (root.settings-tab == "Skills" ? "skills" : "plugins"); accessible-label: "Filter list"; }
                if root.settings-tab == "Plugins" && root.browse-plugins: CheckBox { text: "Official marketplaces"; checked <=> root.official-only;
                    toggled => {root.search-settings(root.settings-query);} }
            }
            if (root.settings-query != "" || root.browse-plugins) && root.settings-rows.length == 0 && root.settings-status == "": Text {
                text: root.settings-query != "" ? "No matches" : root.official-only ? "No plugins from official marketplaces." : "No plugins available."; color: Theme.muted; font-size: 13px;
            }
            if root.settings-tab == "Appearance": AppearancePage { vertical-stretch: 1; }
            if root.settings-tab == "Notifications": VerticalLayout {
                spacing: 6px; alignment: start;
                CheckBox { text: "Notify me when I’m needed"; checked: root.attention-enabled;
                    toggled => {root.save-attention(self.checked);} }
                Text { text: "Show a Windows notification when a background run needs your input or has work ready to review.";
                    color: Theme.muted; font-size: 14px; wrap: word-wrap; }
            }
            if root.settings-tab == "Tasks": TaskEditor {
                vertical-stretch: 1; has-project: root.project != ""; auto-delegate: root.auto-delegate; parallel-workers: root.parallel-workers;
                schedule(auto,parallel) => { root.save-scheduling(auto,parallel); }
                catalog-ready: root.catalog-ready; catalog-status: root.catalog-status;
                reload => { root.reload-models(); } back => { root.close-settings(); } choose-providers => { root.choose-providers(); }
            }
            if root.settings-tab != "Tasks" && root.settings-tab != "Appearance" && root.settings-tab != "Notifications": preference-list := ListView { vertical-stretch: 1;
                for row in root.settings-rows: item := VerticalLayout {
                    property <bool> account: root.settings-tab == "Providers" && row.id != "gemini-project";
                    property <bool> expanded: item.account && row.id == root.expanded-provider;
                    width: preference-list.visible-width;
                    height: account-header.height + (item.expanded ? root.provider-roles.length * 32px + 10px : 0px) + 1px;
                    account-header := HorizontalLayout { spacing: 6px; padding-left: 2px; padding-right: 7px;
                        height: item.account ? 60px : max(root.recommendations ? 76px : 60px, row-copy.preferred-height + 18px);
                        row-copy := VerticalLayout { horizontal-stretch:1; alignment:center; spacing:3px;
                            if item.account: RowAction { label:row.label; detail:row.detail; height:50px; end-inset:92px;
                                glyph:item.expanded ? "\u{e70d}" : "\u{e76c}"; glyph-color:item.expanded ? Theme.accent : Theme.muted;
                                accessible-expanded:item.expanded; accessible-description:row.detail + ". " + row.task-count + " allowed.";
                                Text { x:parent.width - 86px; width:76px; height:parent.height; text:row.task-count;
                                    horizontal-alignment:right; vertical-alignment:center; color:Theme.muted; font-size:12px; accessible-role:none; }
                                activate=>{root.expand-provider(row.id);} }
                            if !item.account: Text { text: row.label; color: Theme.text; font-size: 15px; font-weight: 600; min-width: 0px; overflow: elide; }
                            if !item.account: Text { text: row.detail; color: Theme.muted; font-size: root.recommendations ? 14px : 13px; min-width: 0px; wrap: word-wrap; }
                        }
                        if root.confirm-id == row.id: VerticalLayout { alignment: center; width: 74px;
                            Action { label: "Cancel"; width: 72px; height: 32px; activate => {root.confirm-id = "";} }
                        }
                        VerticalLayout { alignment: center; width: root.recommendations ? 115px : 100px;
                            if root.recommendations && row.action == "": Text { text: row.button; color: Theme.muted; font-size: 14px; horizontal-alignment: center; }
                            if row.action != "": Action { label: root.settings-working && root.settings-working-id == row.id && (row.action == "recommend" || row.action == "install") ? "Installing…" : root.confirm-id == row.id ? "Confirm" : row.button;
                                accessible-label: root.recommendations ? self.label + " " + row.label
                                    : item.account && root.confirm-id != row.id ? self.label + (row.action == "logout" ? " of " : " to ") + (row.id == "Gemini CLI" ? "Gemini" : row.label) : self.label;
                                accessible-description: row.button + " " + row.label; width: root.recommendations ? 112px : 98px; height: root.recommendations ? 36px : 32px; selected: true;
                                enabled: !root.settings-working; activate => {
                                    if (row.action == "remove" || row.action == "logout") && root.confirm-id != row.id {root.confirm-id = row.id;}
                                    else {root.confirm-id = ""; root.settings-action(row.action,row.id);}
                                } }
                        }
                    }
                    if item.expanded: VerticalLayout {
                        padding-left:32px; padding-bottom:10px;
                        for role[i] in root.provider-roles: CheckBox {
                            text:role.label; checked:role.selected; height:32px;
                            toggled=>{root.set-provider-role(row.id, i, self.checked);}
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                }
            }
            if root.settings-tab != "Tasks" && root.settings-tab != "Appearance" && root.settings-tab != "Notifications": HorizontalLayout {
                height: 48px; spacing: 10px; alignment: stretch;
                VerticalLayout { alignment: center; Action { label: "Refresh"; width: 83px; height: 34px; enabled: !root.settings-working; activate => {root.load-settings(true);} } }
                Text { text: root.settings-status; color: Theme.muted; font-size: 13px; horizontal-stretch: 1; min-width: 0px; wrap: word-wrap; overflow: elide; vertical-alignment: center; }
                if root.more-plugins: VerticalLayout { alignment: center; Action { label: "Show more"; width: 106px; height: 34px; activate => {root.show-more-plugins();} } }
            }
        }
    }

    if root.compact && root.context-visible: TouchArea {
        x: nav.width; width: root.width - self.x; height: root.height;
        Rectangle { background: #08090c88; }
        clicked => {root.compact-context = false;}
    }
    context := FocusScope {
        visible: root.context-visible; x: nav.width; width: root.compact ? 228px : 218px; height: root.height;
        capture-key-pressed(e) => {
            if root.compact-context && e.text == Key.Escape {
                root.compact-context = false;
                sidebar-switch.focus();
                return accept;
            }
            return reject;
        }
        Rectangle { background: Theme.sidebar; }
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.line; }
        if root.studio-open: StudioNavigation {
            x: 14px; y: 15px; width: parent.width - 29px; height: parent.height - 28px;
            picked => { root.compact-context = false; }
        }
        if root.settings-open: VerticalLayout {
            padding: 14px; padding-top: 19px; alignment: start; spacing: 5px;
            Text { text: "Settings"; height: 36px; color: Theme.text; font-size: 20px; font-weight: 600; }
            for tab[i] in ["Providers", "Plugins", "Skills", "MCP servers", "Tasks", "Appearance", "Notifications"]: RowAction {
                label: tab; glyph: ["\u{e77b}","\u{e74c}","\u{e8f1}","\u{e774}","\u{e90f}","\u{e790}","\u{ea8f}"][i]; selected: root.settings-tab == tab;
                enabled: !root.settings-working; activate => {root.visit-settings(tab,root.settings-provider);root.compact-context=false;}
            }
        }
        if root.chat-screen: VerticalLayout {
            padding: 14px; padding-top: 18px; spacing: 9px;
            Text { text: "Project"; color: Theme.muted; font-family: Theme.mono; font-size: 12px; height: 16px; }
            RowAction { end-inset:26px; label: root.project == "" ? "Choose folder…" : root.project; accessible-label:"Switch project"; enabled: !root.busy; height:36px;
                glyph: "\u{e8b7}"; glyph-color: Theme.halfway; label-font: Theme.mono;
                activate=>{root.open-project();}
                Text { x: parent.width - 20px; text:"\u{e70d}"; font-family:"Segoe MDL2 Assets"; color:Theme.muted; font-size:11px; vertical-alignment:center; }
            }
            Rectangle { height:1px; background:Theme.line; }
            HorizontalLayout { height: 34px; spacing: 5px;
                Text { text: "Chats"; color: Theme.text; font-size: 18px; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                if root.project != "": Action { label: "Work queue"; width: 98px; activate => {root.visit("work");} }
            }
            if root.project != "": LineEdit { height: 34px; placeholder-text: "Search chats"; accessible-label: "Search chats"; text <=> root.chat-query; }
            if root.chat-query != "" && root.search-hits.length == 0: Text { text:"No matching chats"; color:Theme.muted; font-size:13px; wrap:word-wrap; }
            if root.project != "" && root.chat-query == "" && root.rows.length == 0: Text { text:"Your conversations appear here."; color:Theme.muted; font-size:13px; wrap:word-wrap; }
            if root.chat-query == "": ListView { vertical-stretch: 1;
                for chat[i] in root.rows: ChatHistoryRow { title: chat.label; selected: i == root.selection;
                    enabled: !root.busy; restore-delete-focus: root.restore-delete == chat.value;
                    open => {root.compact-context=false; root.select-row(i);} remove => {root.ask-delete(chat, false);} }
            }
            if root.chat-query != "": ListView { vertical-stretch: 1;
                for hit in root.search-hits: ChatHistoryRow { title: hit.label; enabled: !root.busy;
                    selected: root.selection >= 0 && root.rows[root.selection].value == hit.value;
                    restore-delete-focus: root.restore-delete == hit.value;
                    open => {root.select-hit(hit.value); root.chat-query=""; root.compact-context=false;}
                    remove => {root.ask-delete(hit, false);} }
            }
            if root.chat-query != "" && root.search-hits.length == 40: Text { text: "Showing the newest 40 matches."; color: Theme.muted; wrap:word-wrap; font-size:12px; }
            if root.chat-query == "" && (root.older-chats || root.newer-chats): HorizontalLayout {
                if root.newer-chats: Action { label: "Newer chats"; enabled: !root.busy; activate => {root.page(true,false);} }
                if root.older-chats: Action { label: "Older chats"; enabled: !root.busy; activate => {root.page(true,true);} }
            }
        }
    }
    // Disable the outside hit area during the press so Slint delivers that same
    // event to the newly uncovered control. The opener itself toggles on release.
    TouchArea {
        enabled: root.open-panel != OpenPanel.closed;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down &&
                (self.mouse-x < root.anchor-x || self.mouse-x >= root.anchor-right ||
                 self.mouse-y < root.anchor-y || self.mouse-y >= root.anchor-bottom) {
                root.open-panel = OpenPanel.closed;
            }
        }
        clicked => {root.dismiss-panel();}
    }
    if root.open-panel == OpenPanel.delivery && root.running: Flyout {
        width: 196px; height: delivery-rows.preferred-height; x: clamp(root.anchor-right - self.width, 8px,root.width - self.width - 8px); y: root.anchor-y - self.height - 6px;
        escape => {root.dismiss-panel();} init => {after-run.focus();}
        Rectangle {background: Theme.popup; border-color: Theme.line; border-width: 1px; border-radius: 16px;}
        delivery-rows := VerticalLayout { padding: 6px; spacing: 1px;
            after-run := RowAction {label: "Send after this run"; glyph: "\u{e823}"; enabled: composer.can-send; activate => {root.dismiss-panel();root.operate("queue");composer.focus-input();}}
            RowAction {label: "Steer current run"; glyph: "\u{e74a}"; enabled: composer.can-send; activate => {root.dismiss-panel();root.operate("steer");composer.focus-input();}}
        }
    }
    if root.open-panel == OpenPanel.add: Flyout {
        x: root.anchor-x; y: max(8px,root.anchor-y - self.height - 6px); width: 222px; height: add-rows.preferred-height;
        escape => {root.dismiss-panel();} init => {files.focus();}
        Rectangle { background: Theme.popup; border-color: Theme.line; border-width: 1px; border-radius: 16px; }
        add-rows := VerticalLayout { padding: 6px; spacing: 1px;
            files := RowAction { label: "Attach files…"; glyph: "\u{e723}"; activate => {root.dismiss-panel(); root.attach(false);} }
            RowAction { label: "Attach folder…"; glyph: "\u{e8b7}"; activate => {root.dismiss-panel(); root.attach(true);} }
            Rectangle { height: 1px; background: Theme.line; }
            RowAction { label: "Paste text"; glyph: "\u{e77f}"; activate => {root.dismiss-panel(); composer.paste-text();} }
            RowAction { label:root.goal-objective == "" ? "Set a goal" : "Chat goal"; glyph:"\u{e7c1}"; enabled:!root.busy || root.goal-objective != "";
                activate=>{if root.goal-objective == "" {root.begin-goal-draft();} else {root.open-goal();}}
                Text { x:parent.width - 56px; width:44px; height:parent.height; text:"/goal"; color:Theme.muted; font-family:Theme.mono; font-size:12px; horizontal-alignment:right; vertical-alignment:center; accessible-role:none; }
            }
            RowAction { label: "Draw a sketch"; glyph: "\u{e104}"; activate => {root.dismiss-panel(); Sketch.edit(); composer.focus-input();} }
            RowAction { label: "Take screenshot"; glyph: "\u{e722}"; enabled: !root.capturing; activate => {root.dismiss-panel(); root.take-screenshot();} }
        }
    }
    if root.open-panel == OpenPanel.outputs: Flyout {
        x: root.anchor-right - self.width; y: root.anchor-bottom + 6px;
        width: 284px; height: 96px + (root.outputs.length == 0 ? 47px : min(root.outputs.length, 4) * 64px);
        escape => {root.dismiss-panel();} init => {self.focus();}
        Rectangle { background: Theme.popup; border-color: Theme.line; border-width: 1px; border-radius: 16px; }
        VerticalLayout { padding: 8px; spacing: 3px;
            HorizontalLayout { height: 36px; padding-left: 8px;
                Text { text: "Outputs"; vertical-alignment: center; font-weight: 600; font-size: 15px; color: Theme.text; } }
            if root.outputs.length == 0: HorizontalLayout { padding-left: 8px; padding-right: 8px; vertical-stretch: 1;
                Text { text: "Sound effects, images, 3D models and screenshots from this chat appear here."; wrap: word-wrap; font-size: 13px; color: Theme.muted; } }
            if root.outputs.length > 0: output-list := ListView {
                vertical-stretch: 1;
                for item in root.outputs: output-row := Action {
                    width: output-list.visible-width; height: 64px; icon-only: true;
                    label: item.open-label; accessible-description: item.detail;
                    Rectangle { x: 8px; y: 8px; width: 72px; height: 48px; background: Theme.sidebar; border-radius: 7px; clip: true;
                        Image { width: parent.width; height: parent.height; source: item.shot != "" ? root.shot-image(item.shot,false) : root.file-image(item.preview); image-fit: cover; } }
                    VerticalLayout { x: 92px; y: 0px; width: parent.width - 100px; height: parent.height; alignment: center; spacing: 2px;
                        Text { text: item.title; color: Theme.text; font-size: 14px; overflow: elide; }
                        Text { text: item.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
                    }
                    activate => {if item.shot != "" {root.view-shot(item.shot);} else if item.path != "" {root.view-image(item.path,item.asset-id);} else {root.dismiss-panel(); Studio.asset-action(item.asset-id,item.sound ? "play" : "inspect");}}
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            Action { label: "View all screenshots"; glyph: "\u{e8b9}"; height: 34px;
                activate => {root.dismiss-panel(); root.album-open = true; root.refresh-album();} }
        }
    }

    if root.open-panel == OpenPanel.activity: Flyout {
        width: min(386px,pane.width - 18px); x: clamp(root.anchor-right - self.width, rail.width + 8px, root.width - self.width - 8px);
        y: root.anchor-bottom + 5px; height: min(activity-stack.preferred-height + 32px, root.height - self.y - 16px);
        escape=>{root.dismiss-panel();} init=>{self.focus();}
        Rectangle { background: Theme.popup; border-width:1px; border-color:Theme.line; border-radius:17px; }
        scroll := ScrollView { x:16px; y:14px; width:parent.width - 32px; height:parent.height - 28px;
            content-width:self.visible-width; content-height:activity-stack.preferred-height;
            activity-stack := VerticalLayout { width:scroll.visible-width - 5px; spacing:10px; alignment:start;
                HorizontalLayout { height:30px;
                    Text { text:"Session activity"; color:Theme.text; font-size:18px; font-weight:600; vertical-alignment:center; horizontal-stretch:1; }
                    Action { label:"Close activity"; glyph:"\u{e711}"; icon-only:true; width:30px; height:30px; activate=>{root.dismiss-panel();} }
                }
                Text { text:root.running ? (root.live-activity != "" ? root.live-activity : root.chat-provider + " is responding") : root.state-label; color:Theme.state-color(root.running ? "In progress" : root.state-label); font-family:Theme.mono; font-size:14px; overflow: elide; }
                if root.action != "": Text { text:root.action; color:Theme.muted; wrap:word-wrap; font-size:14px; }
                if root.workers.length > 0: Rectangle { height:1px; background:Theme.line; }
                if root.workers.length > 0: WorkerGroup { label:"Subagents (" + root.workers.length + ")"; workers:root.workers;
                    open:root.show-workers; expanded-worker:root.expanded-worker; toggle=>{root.show-workers=!root.show-workers;}
                    choose-worker(id)=>{root.toggle-worker(id);} stop-worker(id)=>{root.stop-worker(id);} direct-worker(id,title)=>{root.direct-worker(id,title);} }
                if root.workers.length == 0: Text { text:root.running ? "No subagents dispatched yet." : "No subagents were dispatched."; color:Theme.muted; font-size:13px; wrap:word-wrap; }
                if root.checkpoint != "": Rectangle { height:1px; background:Theme.line; }
                if root.checkpoint != "": RowAction { label:"Project handoff"; glyph:root.show-checkpoint ? "\u{e70d}" : "\u{e76c}";
                    accessible-expanded:root.show-checkpoint; activate=>{root.show-checkpoint=!root.show-checkpoint;} }
                if root.checkpoint != "" && root.show-checkpoint: Text { text:root.checkpoint; wrap:word-wrap; color:Theme.text; font-size:14px; }
            }
        }
    }
    if root.open-panel == OpenPanel.usage: Flyout {
        x: clamp(root.anchor-right - self.width, 8px, root.width - self.width - 8px); y: root.anchor-bottom + 4px;
        width: 236px; height: usage-rows.preferred-height; escape => {root.dismiss-panel();} init => {self.focus();}
        Rectangle { background: Theme.popup; border-radius: 15px; border-width: 1px; border-color: Theme.line; }
        usage-rows := VerticalLayout {
            padding: 14px; spacing: 9px;
            HorizontalLayout { height: 22px;
                Text { text: "Context window"; color: Theme.text; font-size: 14px; horizontal-stretch: 1; vertical-alignment: center; }
                RemainingValue { fraction: root.context-meter.remaining; width: 45px; font-size: 14px; }
            }
            Text { text: root.context-meter.detail; color: Theme.muted; font-size: 12px; }
            Rectangle { height: 1px; background: Theme.line; }
            for window in root.usage-meters: HorizontalLayout { height: 22px;
                Text { text: window.detail; color: Theme.text; font-size: 14px; horizontal-stretch: 1; vertical-alignment: center; }
                RemainingValue { fraction: window.remaining; width: 45px; font-size: 14px; }
            }
            if root.usage-meters.length == 0: Text { text: root.usage-loading ? "Checking account limits…" : "Account limits unavailable"; color: Theme.muted; font-size: 13px; }
        }
    }
    if root.open-panel == OpenPanel.options: Flyout {
        x: root.anchor-right - self.width; y: root.anchor-bottom + 4px; width: 194px;
        height: option-rows.preferred-height; escape => {root.dismiss-panel();} init => {self.focus();}
        Rectangle { background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: 16px; }
        option-rows := VerticalLayout { padding: 6px; spacing: 2px;
            Text { text: root.state-label; color: Theme.muted; font-size: 12px; height: 25px; vertical-alignment: center; }
            if root.can-review: RowAction { label: root.checkpoint-only ? "Accept decisions" : "Accept change"; activate => {root.operate("accept"); root.open-panel = OpenPanel.closed;} }
            if root.can-retry: RowAction { label: "Retry in new chat"; activate => {root.operate("retry"); root.open-panel = OpenPanel.closed;} }
            if root.can-discard: RowAction { label: "Discard change"; activate => {root.operate("discard"); root.open-panel = OpenPanel.closed;} }
            Rectangle { height: 1px; background: Theme.line; }
            RowAction { label: "Delete chat…"; glyph: "\u{e74d}"; glyph-color: Theme.scarce;
                activate => {root.ask-delete(root.rows[root.selection], true);} }
        }
    }
    if root.open-panel == OpenPanel.effort: Flyout {
        width: 320px; height: 136px; x: clamp(root.anchor-right - self.width, 8px, root.width - self.width - 8px); y: root.anchor-y - self.height - 6px;
        escape => {root.dismiss-panel();} init => {if root.chat-choices.efforts.length > 1 {track.focus();} else {header.focus();}}
        Rectangle { background: Theme.popup; border-radius: 21px; border-width: 1px; border-color: Theme.line; }
        header := Action {
            x: 3px; y: 3px; width: parent.width - 6px; height: 76px; border-radius: 18px;
            icon-only: true; label: "Chat model";
            accessible-description: effort-title.text + ", " + root.chat-choices.current-model;
            activate => { root.highlighted = root.chat-choices.model-index; root.open-panel = OpenPanel.models; }
            VerticalLayout {
                x: 16px; width: parent.width - 32px; height: parent.height; alignment: center; spacing: 3px;
                effort-title := Text {
                    text: track.shown >= 0 ? root.chat-choices.efforts[track.shown].label : root.chat-choices.current-effort;
                    horizontal-alignment: center; color: Theme.text; font-size: 20px; font-weight: 600; accessible-role: none;
                }
                Text { text: root.chat-choices.current-model + "  ›"; horizontal-alignment: center; overflow: elide;
                    color: Theme.muted; font-size: 14px; accessible-role: none; }
            }
        }
        track := EffortTrack { x: 15px; y: header.y + header.height + 4px; width: parent.width - 30px; height: 40px;
            visible: root.chat-choices.efforts.length > 0;
            levels: root.chat-choices.efforts; selected: root.chat-choices.effort-index; name: "Chat reasoning effort";
            dismiss => {root.dismiss-panel();}
            commit(i) => { if i != root.chat-choices.effort-index { root.choose-inference(false,root.chat-choices.efforts[i].value); } } }
        if root.chat-choices.efforts.length == 0: Text { x: 12px; y: track.y; width: parent.width - 24px; height: 30px;
            text: "No effort levels available"; color: Theme.muted; horizontal-alignment: center; }
    }
    if root.open-panel == OpenPanel.models: Flyout {
        width: 320px; height: min(350px, root.anchor-y - 8px, 54px + root.default-extra + root.chat-choices.models.length * 38px); x: clamp(root.anchor-right - self.width, 8px, root.width - self.width - 8px); y: root.anchor-y - self.height - 6px;
        escape => {root.dismiss-panel();} init => {navigation.focus();}
        Rectangle { background: Theme.popup; border-radius: 21px; border-width: 1px; border-color: Theme.line; }
        Text { x: 18px; y: 13px; height: 24px; text: "Select model"; color: Theme.muted; font-size: 14px; }
        list := ScrollView { x: 8px; y: 40px; width: parent.width - 16px; height: parent.height - 51px;
            content-width: self.visible-width; content-height: model-rows.preferred-height;
            model-rows := VerticalLayout { width: list.visible-width;
                for m[i] in root.chat-choices.models: RowAction { end-inset:34px;
                    height: 38px + (i == 0 ? root.default-extra : 0px); label: m.label; selected: i == root.highlighted; border-radius: 14px;
                    detail: m.value == "Default model" ? "Use the configured Codex model" : "";
                    accessible-description: i == root.chat-choices.model-index ? "Selected" : "";
                    if i == root.chat-choices.model-index: Text { x: parent.width - 32px; width: 22px; vertical-alignment: center;
                        color: Theme.text; font-size: 14px; text: "\u{e73e}"; font-family: "Segoe MDL2 Assets"; accessible-role: none; }
                    activate => { root.select-model(i); }
                }
            }
            function reveal() {
                let top = root.highlighted * 38px + (root.highlighted > 0 ? root.default-extra : 0px);
                if top + self.content-y < 0px { self.content-y = -top; }
                else if top + 38px + self.content-y > self.visible-height { self.content-y = self.visible-height - top - 38px; }
            }
            init => { self.reveal(); }
        }
        navigation := FocusScope {
            focus-on-click: false;
            key-pressed(e) => {
                if e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Home || e.text == Key.End {
                    root.highlighted = clamp(e.text == Key.Home ? 0 : e.text == Key.End ? root.chat-choices.models.length - 1 :
                        root.highlighted + (e.text == Key.DownArrow ? 1 : -1), 0, root.chat-choices.models.length - 1);
                    list.reveal(); return accept;
                }
                if e.text == Key.Return || e.text == Key.Space {
                    root.select-model(root.highlighted); return accept;
                }
                if e.text == Key.Escape { root.dismiss-panel(); return accept; }
                return reject;
            }
        }
    }
    if root.open-panel == OpenPanel.policy: Flyout {
        x: clamp(root.anchor-x, 8px, root.width - self.width - 8px);
        y: max(8px, root.anchor-y - 6px - self.height);
        width: 292px; height: content.preferred-height; escape => {root.dismiss-panel();} init => {done.focus();}
        Rectangle { background: Theme.popup; border-radius: 15px; border-width: 1px; border-color: Theme.line; }
        content := VerticalLayout { padding: 12px; spacing: 5px;
            HorizontalLayout { height: 30px;
                Text { text: "Chat subagents";
                    font-size: 16px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                done := Action { label: "Done"; width: 58px; height: 30px; activate => {root.dismiss-panel();} }
            }
            CheckBox { text: root.project-worker-defaults ? "Use project defaults" : "Use global defaults"; checked: root.inherit-policy;
                toggled => { root.change-policy(self.checked ? "inherit" : "customize",""); } }
            if root.inherit-policy: Text {
                private property <string> effort: root.cap-index < 0 || root.cap-index >= root.cap-levels.length || root.cap-levels[root.cap-index].value == ""
                    ? "Any effort" : root.cap-levels[root.cap-index].label + " effort limit";
                text:root.allowed-model-names + (root.worker-provider-available && !root.worker-models-blocked ? " · " + self.effort : "");
                color:Theme.muted; font-size:13px; wrap:word-wrap; overflow:elide; max-height:54px;
            }
            if !root.inherit-policy: AgentPolicyFields { blocked-models:root.worker-models-blocked; has-provider:root.worker-provider-available; allowed-model-names:root.allowed-model-names;
                all-models:root.all-models; policy-models:root.policy-models; cap-levels:root.cap-levels; cap-index:root.cap-index;
                effort-name:"Maximum subagent effort"; change-policy(f,v)=>{root.change-policy(f,v);} dismiss=>{root.dismiss-panel();} }
            if !root.inherit-policy && !root.catalog-ready: Action { label: "Refresh models"; enabled: root.catalog-status != "Loading models…"; activate => {root.reload-models();} }
            RowAction { label:"Provider settings"; glyph:"\u{e713}";
                activate=>{root.choose-providers();} }
        }
    }
    if root.delete-id != "": DeleteChatDialog {
        width: root.width; height: root.height; chat-title: root.delete-title;
        cancel => {
            root.restore-delete = root.delete-from-menu ? "" : root.delete-id;
            root.delete-id = "";
            if root.delete-from-menu { options.focus(); }
        }
        confirm => { root.delete-chat(root.delete-id); root.delete-id = ""; }
    }
}
