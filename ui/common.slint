import { ProgressIndicator } from "std-widgets.slint";

export component ActivityLine inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    height: 24px;
    VerticalLayout {
        width: 24px; alignment: center;
        ProgressIndicator { indeterminate: true; height: 4px; }
    }
    Text { text: root.label; color: Theme.muted; font-size: 14px; min-width: 0px;
        horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
}

export struct ThemeColors {
    rail: color,
    brand-fill: color,
    popup: color,
    track: color,
    canvas: color,
    sidebar: color,
    surface: color,
    selected: color,
    line: color,
    text: color,
    muted: color,
    accent: color,
    symbol: color,
    keyword: color,
    accent-hover: color,
    disabled: color,
    ample: color,
    halfway: color,
    scarce: color,
}

export global Theme {
    in-out property <ThemeColors> colors;
    out property <color> rail: colors.rail;
    out property <color> brand-fill: colors.brand-fill;
    out property <color> popup: colors.popup;
    out property <color> track: colors.track;
    out property <color> canvas: colors.canvas;
    out property <color> sidebar: colors.sidebar;
    out property <color> surface: colors.surface;
    out property <color> selected: colors.selected;
    out property <color> line: colors.line;
    out property <color> text: colors.text;
    out property <color> muted: colors.muted;
    out property <color> accent: colors.accent;
    out property <color> symbol: colors.symbol;
    out property <color> keyword: colors.keyword;
    out property <string> mono: "Consolas";
    public pure function state-color(state: string) -> color {
        if state == "Finished" || state == "Accepted" || state == "Ready" { return ample; }
        if state == "Blocked" || state == "Failed" { return scarce; }
        if state == "Queued" || state == "Ready for review" || state == "Interrupted" { return halfway; }
        if state == "Working" || state == "Running" || state == "In progress" || state == "Integrating" || state == "Checking" { return symbol; }
        return muted;
    }
    out property <color> accent-hover: colors.accent-hover;
    out property <color> disabled: colors.disabled;
    out property <color> ample: colors.ample;
    out property <color> halfway: colors.halfway;
    out property <color> scarce: colors.scarce;
}

export component Action inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <string> glyph;
    in property <bool> icon-only: false;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> outlined: false;
    in property <bool> leading: false;
    in property <length> end-inset: 10px;
    in property <color> glyph-color: root.selected ? Theme.accent : Theme.muted;
    in property <string> label-font: "Segoe UI";
    in property <bool> enabled: true;
    callback activate();
    height: 36px;
    border-radius: primary ? 18px : 9px;
    border-width: focus.has-focus || outlined ? 1px : 0px;
    border-color: focus.has-focus ? Theme.accent : Theme.line;
    background: primary ? (enabled ? (area.pressed ? Theme.muted : area.has-hover ? Theme.accent-hover : Theme.accent) : Theme.disabled)
        : enabled && area.pressed ? Theme.track : selected ? Theme.selected : enabled && area.has-hover ? Theme.surface : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.activate(); } }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: root.icon-only ? 0px : 10px; padding-right: root.icon-only ? 0px : root.end-inset;
        spacing: 8px; alignment: root.leading && !root.icon-only ? start : center;
        if root.glyph != "": Text { text: root.glyph; vertical-alignment: center; font-size: 15px;
            horizontal-alignment: center; font-family: "Segoe MDL2 Assets";
            color: !root.enabled ? Theme.muted : root.primary ? Theme.canvas : root.glyph-color; accessible-role: none; }
        if !root.icon-only && root.detail == "": Text { text: root.label; vertical-alignment: center; font-size: 14px; font-family: root.label-font;
            horizontal-alignment: root.leading ? left : center; min-width: 0px;
            color: root.primary && root.enabled ? Theme.canvas : root.enabled ? Theme.text : Theme.muted; overflow: elide; accessible-role: none; }
        if root.detail != "": VerticalLayout { alignment: center; spacing: 2px;
            Text { text: root.label; color: Theme.text; font-size: 14px; overflow: elide; min-width: 0px; accessible-role: none; }
            Text { text: root.detail; color: Theme.muted; font-size: 12px; overflow: elide; min-width: 0px; accessible-role: none; }
        }
    }
    area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.activate(); } }
    focus := FocusScope { focus-on-click: false; width: 0px; enabled: root.enabled;
        key-pressed(e) => { if e.text == Key.Return || e.text == Key.Space { root.activate(); return accept; } return reject; }
    }
}

export component RowAction inherits Action {
    leading: true;
}
