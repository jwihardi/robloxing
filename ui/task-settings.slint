import { CheckBox, SpinBox } from "std-widgets.slint";
import { Action, RowAction, Theme } from "common.slint";
import { EffortTrack, PickerOption, PolicyChoices, PolicyModel } from "agent-policy.slint";

export struct TaskProvider { id: string, label: string, enabled: bool, models: [int] }
export struct TaskModelPage { groups: [TaskProvider], number: int, count: int }

export global TaskControls {
    in-out property <string> area: "Images";
    out property <string> settings-area: "Images";
    in-out property <bool> for-run;
    in property <bool> inherited;
    in property <PolicyChoices> choices;
    in property <[TaskProvider]> providers;
    in property <int> selected-models;
    in property <int> function-limit;
    in property <int> seconds;
    in property <bool> summary;
    in property <bool> elevenlabs;
    in property <bool> sound-key;
    in property <string> error;
    callback change(string,string);
    callback set-provider(string,bool);
    pure callback model-page([TaskProvider],int,int,int) -> TaskModelPage;
    public function open(run: bool, area: string) {
        self.for-run = run; self.area = area;
        if !run { self.settings-area = area; }
        self.change("open","");
    }
}

component TaskTabs inherits Rectangle {
    height: 40px; accessible-role: tab-list; accessible-label: "Task types"; accessible-orientation: horizontal;
    accessible-item-index: root.current; accessible-item-count: root.tabs.length; forward-focus: keys;
    private property <[PickerOption]> tabs: [
        {value:"Workers",label:"Workers"}, {value:"Images",label:"Image generation"},
        {value:"Models",label:"Model design"}, {value:"Sounds",label:"Sound effects"}, {value:"Ghidra",label:"Decompilation"}
    ];
    private property <int> current: (TaskControls.area == "Workers" || TaskControls.area == "LevelDesign") ? 0 : TaskControls.area == "Images" ? 1 : TaskControls.area == "Models" ? 2 : TaskControls.area == "Sounds" ? 3 : 4;
    function select-tab(i: int) {
        if i != root.current { TaskControls.open(false,root.tabs[i].value); }
    }
    keys := FocusScope {
        width: 0px; focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.RightArrow { root.select-tab(mod(root.current + 1,root.tabs.length)); return accept; }
            if e.text == Key.LeftArrow { root.select-tab(mod(root.current + root.tabs.length - 1,root.tabs.length)); return accept; }
            if e.text == Key.Home { root.select-tab(0); return accept; }
            if e.text == Key.End { root.select-tab(root.tabs.length - 1); return accept; }
            return reject;
        }
    }
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    HorizontalLayout { alignment: start; spacing: 3px;
        for task[i] in root.tabs: Action {
            width: [78px,132px,106px,106px,124px][i]; height: parent.height;
            label: task.label; selected: i == root.current;
            accessible-role: tab; accessible-item-index: i; accessible-item-selectable: true; accessible-item-selected: self.selected;
            background: self.hovered ? Theme.surface : transparent;
            tab-stop: false; border-width: keys.has-focus && self.selected ? 1px : 0px; border-color: Theme.accent;
            activate => { keys.focus(); root.select-tab(i); }
            if self.selected: Rectangle { x: 10px; y: parent.height - 3px; height: 3px; width: parent.width - 20px;
                border-radius: 1.5px; background: Theme.accent; }
        }
    }
}

component TaskModels inherits Rectangle {
    in property <string> task-name;
    in property <bool> inherited;
    in property <bool> catalog-ready;
    callback choose-providers();
    private property <int> requested-page: 0;
    private property <string> restore-provider;
    changed task-name => { root.requested-page = 0; root.restore-provider = ""; }
    private property <bool> show-status: TaskControls.choices.blocked-models || !TaskControls.choices.has-provider;
    private property <length> list-top: root.show-status ? 72px : 40px;
    private property <int> columns: max(1, floor(root.width / 204px));
    private property <length> row-height: 32px;
    private property <int> rows: max(2,floor((root.height - root.list-top) / root.row-height));
    private property <[TaskProvider]> groups: TaskControls.providers;
    private property <TaskModelPage> page;
    // Keep the focused model control alive when only its selection or effort changes.
    function arrange() { root.page = TaskControls.model-page(root.groups,root.columns,root.rows,root.requested-page); }
    init => { root.arrange(); }
    changed groups => { root.arrange(); }
    changed rows => { root.arrange(); }
    changed columns => { root.arrange(); }
    changed requested-page => { root.arrange(); }
    min-height: 0px; preferred-height: 0px; min-width: 0px;
    accessible-role: tab-panel; accessible-label: root.task-name + " models";
    HorizontalLayout { x: 0px; y: 0px; width: root.width; height: 34px; spacing: 6px;
        Text { text: TaskControls.area == "Ghidra" ? "Summary models" : "Allowed models";
            font-size: 18px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
        if TaskControls.choices.has-provider: Text {
            text: TaskControls.choices.all-models ? (TaskControls.area == "LevelDesign" ? "Any allowed worker model" : "Any available model") : TaskControls.selected-models + " selected";
            color: Theme.muted; font-size: 13px; vertical-alignment: center;
        }
        if TaskControls.choices.has-provider && !TaskControls.choices.all-models && !root.inherited: Action {
            label: "Allow any model"; width: 128px; height: 32px;
            activate => { TaskControls.change("model",""); }
        }
        if root.page.count > 1: Action { width: 32px; height: 32px; icon-only: true; label: "Previous models"; glyph: "\u{e76b}";
            enabled: root.page.number > 0; opacity: self.enabled ? 1 : 0.4; activate => { root.requested-page = root.page.number - 1; } }
        if root.page.count > 1: Text { text: (root.page.number + 1) + " / " + root.page.count; font-size: 13px;
            color: Theme.muted; vertical-alignment: center; horizontal-alignment: center; }
        if root.page.count > 1: Action { width: 32px; height: 32px; icon-only: true; label: "Next models"; glyph: "\u{e76c}";
            enabled: root.page.number + 1 < root.page.count; opacity: self.enabled ? 1 : 0.4; activate => { root.requested-page = root.page.number + 1; } }
    }
    if root.show-status: HorizontalLayout { x: 0px; y: 38px; width: root.width; height: 28px; spacing: 8px;
        Text { text: TaskControls.choices.blocked-models ? "Your selected models belong to disabled providers."
                : TaskControls.area == "LevelDesign" ? "Enable a worker provider under General." : TaskControls.for-run ? "No providers are enabled for this task." : "Enable a provider to allow models for this task.";
            horizontal-stretch: 1; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
        if TaskControls.for-run: Action { label: "Provider settings"; width: 120px; activate => { root.choose-providers(); } }
    }
    Rectangle {
        x: 0px; y: root.list-top; width: root.width; height: max(0px,root.height - self.y); clip: true;
        VerticalLayout { x: 0px; y: 0px; width: parent.width; height: parent.height; alignment: start;
            for group in root.page.groups: Rectangle {
                height: (1 + ceil(group.models.length / root.columns)) * root.row-height;
                accessible-role: groupbox; accessible-label: group.label;
                HorizontalLayout { x: 0px; y: 0px; height: root.row-height; width: parent.width; spacing: 10px;
                    Text { text: group.label; color: Theme.text; font-weight: 600; font-size: 15px; vertical-alignment: center; }
                    if !TaskControls.for-run && TaskControls.area != "LevelDesign": Action {
                        width: 42px; height: root.row-height; icon-only: true; label: group.label + " for " + root.task-name;
                        accessible-role: switch; accessible-checkable: true; accessible-checked: group.enabled;
                        init => { if root.restore-provider == group.id { self.focus(); root.restore-provider = ""; } }
                        activate => { root.restore-provider = group.id; TaskControls.set-provider(group.id,!group.enabled); }
                        Rectangle { x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                            width: 32px; height: 18px; border-radius: 9px; background: group.enabled ? Theme.accent : Theme.track;
                            border-width: 1px; border-color: group.enabled ? Theme.accent : Theme.muted;
                            Rectangle { x: group.enabled ? parent.width - self.width - 3px : 3px; y: 3px;
                                width: 12px; height: 12px; border-radius: 6px; background: group.enabled ? Theme.canvas : Theme.muted; }
                        }
                    }
                    if group.enabled && group.models.length == 0 && root.catalog-ready: Text {
                        text: "No models reported"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1;
                        Rectangle { y: (parent.height - self.height)/2; width: parent.width; height: 1px; background: Theme.line; }
                    }
                }
                for index[i] in group.models: RowAction {
                    private property <PolicyModel> model: TaskControls.choices.models[index];
                    x: mod(i,root.columns) * self.width; y: (1 + floor(i / root.columns)) * root.row-height;
                    width: parent.width / root.columns; height: root.row-height;
                    label: self.model.label; enabled: !root.inherited;
                    glyph: self.model.selected ? "\u{e73a}" : "\u{e739}"; glyph-color: self.model.selected ? Theme.accent : Theme.muted;
                    accessible-role: checkbox; accessible-checkable: true; accessible-checked: self.model.selected;
                    activate => { TaskControls.change("model",self.model.value); }
                }
            }
        }
    }
}

export component TaskEditor inherits VerticalLayout {
    in property <bool> catalog-ready;
    in property <string> catalog-status;
    in property <bool> has-project;
    in property <bool> auto-delegate;
    in property <bool> parallel-workers;
    callback reload();
    callback back();
    callback choose-providers();
    callback schedule(bool,bool);
    private property <bool> workers: TaskControls.area == "Workers";
    private property <bool> level-design: TaskControls.area == "LevelDesign";
    private property <bool> local: TaskControls.area == "Ghidra";
    private property <bool> inherited: TaskControls.for-run && TaskControls.inherited;
    private property <string> task-name: root.workers ? "Workers" : root.level-design ? "Level design" : root.local ? "Decompilation"
        : TaskControls.area == "Models" ? "Model design" : TaskControls.area == "Sounds" ? "Sound effects" : "Image generation";
    private property <bool> hosted-sound: TaskControls.area == "Sounds" && TaskControls.elevenlabs;
    private property <bool> uses-models: !root.hosted-sound && (!root.local || TaskControls.summary);
    spacing: 10px; min-height: 0px;
    if !TaskControls.for-run: TaskTabs {}
    if !TaskControls.for-run && (root.workers || root.level-design): HorizontalLayout {
        height: 34px; spacing: 4px; alignment: start;
        for section[i] in ["General", "Level design"]: Action {
            width: i == 0 ? 80px : 108px; label: section;
            selected: i == 0 ? root.workers : root.level-design;
            accessible-role: radio-button; accessible-checkable: true; accessible-checked: self.selected;
            activate => { if !self.selected { TaskControls.open(false,i == 0 ? "Workers" : "LevelDesign"); } }
        }
    }
    if root.level-design: Text { text: "For map layouts, blockouts and encounter pacing. Each chat’s worker limits also apply.";
        color: Theme.muted; font-size: 13px; wrap: word-wrap; }
    if TaskControls.for-run: HorizontalLayout { height: 38px;
        Text { text: root.task-name + " settings"; color: Theme.text; font-size: 21px; font-weight: 600;
            vertical-alignment: center; horizontal-stretch: 1; }
        CheckBox { text: "Use task defaults"; checked: TaskControls.inherited;
            toggled => { TaskControls.change(self.checked ? "inherit" : "customize",""); } }
    }
    if TaskControls.area == "Sounds": VerticalLayout { spacing: 4px;
        CheckBox { text: "Use ElevenLabs SFX v3"; checked: TaskControls.elevenlabs;
            toggled => { TaskControls.change("elevenlabs", self.checked ? "true" : "false"); } }
        Text { text: root.hosted-sound ? (TaskControls.sound-key ? "Sound prompts go to ElevenLabs and use your account credits." : "Set ELEVENLABS_API_KEY and restart Workshop to generate with ElevenLabs. Each request uses account credits.")
              : "The models below design effects for local rendering. ElevenLabs uses its own model and credits.";
            color: Theme.muted; font-size: 13px; wrap: word-wrap; }
    }
    if root.local: VerticalLayout { spacing: 6px;
        Text { text: "Local analysis"; font-size: 18px; font-weight: 600; color: Theme.text; height: 26px; }
        HorizontalLayout { height: 34px; alignment: start; spacing: 12px;
            Text { text: "Functions per run"; color: Theme.text; vertical-alignment: center; }
            SpinBox { width: 84px; accessible-label: "Functions per run"; enabled: !root.inherited; minimum: 1; maximum: 256;
                value: TaskControls.function-limit; edited(v) => { TaskControls.change("functions",v); } }
            Text { text: "Seconds per function"; color: Theme.text; vertical-alignment: center; }
            SpinBox { width: 84px; accessible-label: "Seconds per function"; enabled: !root.inherited; minimum: 1; maximum: 120;
                value: TaskControls.seconds; edited(v) => { TaskControls.change("seconds",v); } }
        }
        HorizontalLayout { height: 32px; spacing: 12px;
            CheckBox { text: "Generate an AI summary"; enabled: !root.inherited; checked: TaskControls.summary;
                toggled => { TaskControls.change("summary", self.checked ? "true" : "false"); } }
            Text { text: "Shares up to 48 KiB of saved pseudocode with the summary model."; color: Theme.muted;
                font-size: 12px; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center; }
        }
    }
    if root.uses-models: TaskModels { vertical-stretch: 1; task-name: root.task-name; inherited: root.inherited;
        catalog-ready: root.catalog-ready; choose-providers => { root.choose-providers(); } }
    if !root.uses-models: Rectangle { vertical-stretch: 1; }
    if root.uses-models && !root.catalog-ready: HorizontalLayout { height: 30px; spacing: 8px;
        Text { text: root.catalog-status; color: Theme.muted; font-size: 13px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
        Action { label: "Refresh models"; width: 120px; enabled: root.catalog-status != "Loading models…"; activate => { root.reload(); } }
    }
    if root.uses-models && TaskControls.choices.has-provider: VerticalLayout { spacing: 5px;
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout { height: 42px; spacing: 12px;
            Text { text: "Maximum effort"; color: Theme.text; font-weight: 600; font-size: 14px; horizontal-stretch: 1; vertical-alignment: center; }
            Text { text: TaskControls.choices.levels[TaskControls.choices.cap-index].label; color: Theme.muted; font-size: 14px; vertical-alignment: center; }
            EffortTrack { width: min(300px,root.width * 0.38); height: 34px;
                enabled: !root.inherited && self.levels.length > 1; opacity: self.enabled ? 1 : 0.48;
                name: root.local ? "Maximum summary effort" : root.level-design ? "Maximum level design effort" : root.workers ? "Maximum worker effort" : "Maximum task effort";
                levels: TaskControls.choices.levels; selected: TaskControls.choices.cap-index;
                commit(i) => { TaskControls.change("effort",self.levels[i].value); } dismiss => { root.back(); } }
        }
    }
    if root.workers && root.has-project: HorizontalLayout { height: 32px; spacing: 12px;
        Text { text: "This project"; font-size: 14px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
        CheckBox { text: "Auto-delegate project tasks"; checked: root.auto-delegate; toggled => { root.schedule(self.checked,root.parallel-workers); } }
        CheckBox { text: "Allow two workers in this project"; checked: root.parallel-workers; toggled => { root.schedule(root.auto-delegate,self.checked); } }
    }
    if TaskControls.error != "": Text { text: TaskControls.error; color: Theme.scarce; wrap: word-wrap; font-size: 13px; }
}
